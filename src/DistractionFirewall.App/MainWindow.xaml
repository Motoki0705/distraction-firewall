<Window x:Class="DistractionFirewall.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Distraction Firewall"
        Width="720"
        Height="690"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        AutomationProperties.Name="Distraction Firewall">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D9DEEA" BorderThickness="0,0,0,1" Padding="28,20">
            <StackPanel>
                <TextBlock FontSize="25" FontWeight="SemiBold" Text="Distraction Firewall" />
                <TextBlock Margin="0,5,0,0" Foreground="#4E5668"
                           Text="Windows 11 端末全体で、YouTubeへのアクセスを期限まで制限します。" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,24,28,28">
                <StackPanel Visibility="{Binding IsLoadingPage, Converter={StaticResource BooleanToVisibility}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="260" Height="7" IsIndeterminate="True" />
                    <TextBlock Margin="0,16,0,0" FontSize="16" Text="Lease Runtimeへ接続しています…" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsUnavailablePage, Converter={StaticResource BooleanToVisibility}}"
                            MaxWidth="560">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="Runtimeへ接続できません" />
                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding ErrorMessage}" AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                               Text="新しい制限は開始できません。既に制限中の場合、画面が接続できなくてもLeaseは継続します。" />
                    <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                        <Button Command="{Binding RetryCommand}" Content="再接続" IsDefault="True" />
                        <Button Command="{Binding DiagnoseCommand}" Content="診断" />
                    </StackPanel>
                    <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Text="{Binding DiagnosticSummary}" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsSetupPage, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="制限する対象" />
                    <ItemsControl Margin="0,12,0,18" ItemsSource="{Binding Targets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="16" Background="White"
                                        BorderBrush="#D9DEEA" BorderThickness="1" CornerRadius="8">
                                    <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Target.DisplayName}">
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Target.DisplayName}" />
                                            <TextBlock Margin="0,4,0,0" Foreground="#4E5668" TextWrapping="Wrap"
                                                       Text="{Binding Target.Description}" />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="終了条件" />
                    <Border Margin="0,12,0,0" Padding="16" Background="White"
                            BorderBrush="#D9DEEA" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <RadioButton GroupName="EndMode" IsChecked="{Binding UseDuration}"
                                         Content="期間を指定" FontWeight="SemiBold" />
                            <Grid Margin="26,10,0,16" IsEnabled="{Binding UseDuration}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding DurationChoices}" SelectedItem="{Binding SelectedDuration}"
                                          DisplayMemberPath="Label" AutomationProperties.Name="期間プリセット" />
                                <TextBox Grid.Column="1" Margin="10,0,5,0" Text="{Binding CustomMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsCustomDuration}" AutomationProperties.Name="任意の分数" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="分" />
                            </Grid>

                            <RadioButton GroupName="EndMode" IsChecked="{Binding UseUntil}"
                                         Content="指定時刻まで" FontWeight="SemiBold" />
                            <Grid Margin="26,10,0,0" IsEnabled="{Binding UseUntil}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DatePicker SelectedDate="{Binding UntilDate}" AutomationProperties.Name="終了日" />
                                <TextBox Grid.Column="1" Margin="10,0,0,0" Text="{Binding UntilTime}"
                                         AutomationProperties.Name="終了時刻" />
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="HH:mm" />
                            </Grid>
                            <StackPanel Margin="26,10,0,0"
                                        Visibility="{Binding HasAmbiguousOffsets, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Text="この時刻は夏時間の切替で2回存在します。UTC offsetを選択してください。"
                                           TextWrapping="Wrap" />
                                <ComboBox Width="180" HorizontalAlignment="Left" Margin="0,6,0,0"
                                          ItemsSource="{Binding AmbiguousOffsets}"
                                          SelectedItem="{Binding SelectedAmbiguousOffset}"
                                          DisplayMemberPath="Label" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                               Text="{Binding ErrorMessage}" AutomationProperties.LiveSetting="Assertive" />
                    <Button Margin="0,18,0,0" HorizontalAlignment="Right" MinWidth="150"
                            Command="{Binding PrepareCommand}" Content="確認へ" IsDefault="True" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsConfirmationPage, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="開始前の最終確認" />
                    <Border Margin="0,16,0,0" Padding="18" Background="White"
                            BorderBrush="#D9DEEA" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="対象" />
                            <TextBlock Grid.Column="1" Text="{Binding ConfirmationTargets}" />
                            <TextBlock Grid.Row="1" Margin="0,10,0,0" FontWeight="SemiBold" Text="終了" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Text="{Binding ConfirmationDeadline}" />
                            <TextBlock Grid.Row="2" Margin="0,10,0,0" FontWeight="SemiBold" Text="適用範囲" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Text="この端末の全ユーザー・全アプリ" />
                        </Grid>
                    </Border>
                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding PreparationWarnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,3" Foreground="#765B00" TextWrapping="Wrap" Text="{Binding Message}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Margin="0,16,0,0" Padding="16" Background="#FFF4E5" CornerRadius="8">
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                                   Text="開始後は、終了時刻までアプリから解除・短縮・延長・対象変更できません。アプリを閉じたり削除したりしてもLease Runtimeは継続します。" />
                    </Border>
                    <CheckBox Margin="0,18,0,0" IsChecked="{Binding Acknowledged}"
                              Content="内容と解除できない条件を確認しました" AutomationProperties.Name="開始条件の確認" />
                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                               Text="{Binding ErrorMessage}" AutomationProperties.LiveSetting="Assertive" />
                    <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding BackCommand}" Content="戻る" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" />
                        <Button MinWidth="170" Background="{DynamicResource AccentBrush}" Foreground="White"
                                Command="{Binding CommitCommand}" Content="制限を開始" IsDefault="True" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding IsActivePage, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding ActiveHeading}" />
                    <Border Margin="0,18,0,0" Padding="22" Background="White"
                            BorderBrush="#D9DEEA" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="#4E5668" Text="残り" />
                            <TextBlock Margin="0,2,0,14" FontSize="34" FontWeight="SemiBold"
                                       Text="{Binding RemainingText}" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding ActiveTargets, StringFormat=対象: {0}}" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding ActiveDeadline, StringFormat=終了: {0}}" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding ActiveHealth, StringFormat=状態: {0}}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,16,0,0" Padding="16" Background="#EEF3FF" CornerRadius="8">
                        <TextBlock TextWrapping="Wrap"
                                   Text="この制限はアプリから解除・短縮・延長・変更できません。アプリを閉じても制限は続きます。" />
                    </Border>
                    <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                        <Button Command="{Binding DiagnoseCommand}" Content="診断情報" />
                        <Button Click="Close_Click" Content="アプリを閉じる" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding DiagnosticSummary}" />
                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                               Text="{Binding ErrorMessage}" AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Margin="0,24,0,0" FontSize="11" Foreground="#6A7282"
                               Text="{Binding ActiveLeaseId, StringFormat=Lease ID: {0}}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
