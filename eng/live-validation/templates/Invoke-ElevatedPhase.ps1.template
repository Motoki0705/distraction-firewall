Assert-Condition $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator) 'Elevated phase did not receive an administrator token.'
Assert-Condition ($identity.User.Value -ceq [string]$campaign.owner_sid) 'Over-the-shoulder elevation is unsupported: elevated SID differs from campaign owner SID.'
Assert-Condition ([Environment]::OSVersion.Version.Major -ge 10 -and [Environment]::OSVersion.Version.Build -ge 22000) 'Live validation requires Windows 11.'
$nativeWindowsPowerShell = [IO.Path]::Combine($trustedPowerShellHome, 'powershell.exe')
$currentPowerShellPath = [IO.Path]::GetFullPath([Diagnostics.Process]::GetCurrentProcess().MainModule.FileName)
Assert-Condition ($currentPowerShellPath.Equals($nativeWindowsPowerShell, [StringComparison]::OrdinalIgnoreCase)) 'Elevated phase was not launched by the fixed native Windows PowerShell executable.'
Assert-TrustedSystemBinary $nativeWindowsPowerShell 'native Windows PowerShell 5.1'
Assert-TrustedSystemBinary $msiexec 'native Windows Installer client'
Assert-TrustedSystemBinary $netsh 'native netsh'
Assert-Condition ([IO.Path]::GetDirectoryName($installerRoot).Equals($windowsDirectory, [StringComparison]::OrdinalIgnoreCase)) 'Windows Installer cache root escaped the native Windows directory.'
Assert-Condition (Test-Path -LiteralPath $installerRoot -PathType Container) 'Windows Installer cache root is missing.'
$installerRootItem = Microsoft.PowerShell.Management\Get-Item -LiteralPath $installerRoot -Force
Assert-Condition (($installerRootItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -eq 0) 'Windows Installer cache root is a reparse point.'
Assert-PrivilegedPathAcl $installerRoot 'Windows Installer cache root'
Assert-Condition (Test-Path -LiteralPath $campaign.output_root -PathType Container) 'Embedded campaign output root is missing.'
Assert-Condition (-not (Test-Path -LiteralPath $campaign.paths.active_marker)) 'An active lease exists; elevated validation refuses to mutate Runtime state.'
Assert-ApprovedRecoveryCampaign

foreach ($artifact in @($campaign.candidate.setup, $campaign.candidate.app_msi, $campaign.candidate.runtime_msi)) {
    Assert-LeafFingerprint $artifact.path ([int64]$artifact.size) $artifact.sha256 $artifact.authenticode_status 'candidate binary source'
}
foreach ($artifact in @($campaign.candidate.sbom, $campaign.candidate.checksums)) {
    Assert-LeafFingerprint $artifact.path ([int64]$artifact.size) $artifact.sha256 '' 'candidate metadata source'
}
foreach ($artifact in @($campaign.candidate.hosted_evidence, $campaign.candidate.subjects, $campaign.candidate.attestation_bundle)) {
    Assert-LeafFingerprint $artifact.path ([int64]$artifact.size) $artifact.sha256 '' 'candidate provenance payload source'
}
Assert-LeafFingerprint $campaign.input_records.candidate_manifest_path ([int64]$campaign.input_records.candidate_manifest_size) $campaign.input_records.candidate_manifest_sha256 '' 'candidate manifest source'
Assert-LeafFingerprint $campaign.input_records.provenance_envelope_path ([int64]$campaign.input_records.provenance_envelope_size) $campaign.input_records.provenance_envelope_sha256 '' 'provenance envelope source'
Assert-LeafFingerprint $campaign.input_records.artifact_archive_path ([int64]$campaign.input_records.artifact_archive_size) $campaign.input_records.artifact_archive_sha256 '' 'raw artifact archive'
Assert-PinnedEvidenceInputs
$pendingBaselinePath = Join-Path $stateRoot 'pending-rename-baseline.json'
Assert-Condition (Test-Path -LiteralPath $pendingBaselinePath -PathType Leaf) 'Non-elevated parent did not provide a pending-rename baseline.'
$pendingRenameBaseline = Read-StrictUtf8Json $pendingBaselinePath
Assert-PendingRenameEquals $pendingRenameBaseline (Get-PendingRenameSnapshot) 'UAC boundary'
$systemBaselinePath = Join-Path $stateRoot 'system-baseline.json'
Assert-Condition (Test-Path -LiteralPath $systemBaselinePath -PathType Leaf) 'Non-elevated parent did not provide a system baseline.'
$systemBaseline = Read-StrictUtf8Json $systemBaselinePath
Assert-SystemBaselineEquals $systemBaseline (Get-SystemBaseline) 'UAC boundary'

Assert-Condition (-not (Test-Path -LiteralPath $stageRoot)) 'Fixed campaign stage already exists.'
New-ProtectedStageDirectory $stageRoot
$null = New-Item -ItemType Directory -Path $stagePayloadRoot
$null = New-Item -ItemType Directory -Path $stageEvidenceRoot
$null = New-Item -ItemType Directory -Path $stageScratchRoot

$recoveryEvidence = $null
$serviceEvidence = $null
$smokeEvidence = $null
$uninstallEvidence = $null
$ownedSystemPreflight = $null
$ownedSystemPostflight = $null
try {
    $recoveryEvidence = Invoke-RecoveryIfPresent
    Assert-RuntimeAbsent
    Assert-AppAbsent
    $ownedSystemPreflight = Assert-NoOwnedSystemObjects 'pre-candidate'
    Assert-CandidatePackageStatePreflight
    Assert-Condition (-not (Test-Path -LiteralPath $campaign.paths.common_start_menu_root)) 'Distraction Firewall common Start Menu folder already exists.'
    Assert-Condition (-not (Test-Path -LiteralPath $campaign.paths.active_marker)) 'An active lease appeared after recovery.'

    $stagedSetup = Join-Path $stagePayloadRoot 'candidate-setup.exe'
    $stagedAppMsi = Join-Path $stagePayloadRoot 'candidate-app.msi'
    $stagedRuntimeMsi = Join-Path $stagePayloadRoot 'candidate-runtime.msi'
    Copy-Item -LiteralPath $campaign.candidate.setup.path -Destination $stagedSetup
    Copy-Item -LiteralPath $campaign.candidate.app_msi.path -Destination $stagedAppMsi
    Copy-Item -LiteralPath $campaign.candidate.runtime_msi.path -Destination $stagedRuntimeMsi
    Assert-LeafFingerprint $stagedSetup ([int64]$campaign.candidate.setup.size) $campaign.candidate.setup.sha256 $campaign.candidate.setup.authenticode_status 'staged setup'
    Assert-MsiRecordIdentity $campaign.candidate.app_msi $stagedAppMsi 'staged App MSI'
    Assert-MsiRecordIdentity $campaign.candidate.runtime_msi $stagedRuntimeMsi 'staged Runtime MSI'
    Add-Step 'protected-staging' 'passed' $stagePayloadRoot

    $installLog = Join-Path $stageEvidenceRoot 'candidate-burn-install.log'
    $candidateInstallAttempted = $true
    $installExit = Invoke-InstallerProcess $stagedSetup @('/install', '/quiet', '/norestart', ('/log={0}' -f $installLog)) 'candidate-burn-install'
    Assert-Condition ($installExit -eq 0) "Candidate install failed or requested reboot (exit $installExit)."
    $installedCandidate = $true
    Assert-Condition ((Get-ProductState $campaign.candidate.app_msi.product_code) -eq 5) 'Candidate App ProductCode is not installed.'
    Assert-Condition ((Get-ProductState $campaign.candidate.runtime_msi.product_code) -eq 5) 'Candidate Runtime ProductCode is not installed.'
    Assert-Condition (((Get-RelatedProducts $campaign.fixed.AppUpgradeCode) -join ',') -ceq [string]$campaign.candidate.app_msi.product_code) 'App UpgradeCode family differs from the candidate.'
    Assert-Condition (((Get-RelatedProducts $campaign.fixed.RuntimeUpgradeCode) -join ',') -ceq [string]$campaign.candidate.runtime_msi.product_code) 'Runtime UpgradeCode family differs from the candidate.'
    foreach ($record in @($campaign.candidate.app_msi, $campaign.candidate.runtime_msi)) {
        $localPackage = Get-LocalPackage $record.product_code
        Assert-Condition (-not [string]::IsNullOrWhiteSpace($localPackage)) "Candidate ProductCode has no LocalPackage: $($record.product_code)"
        Assert-LocalPackageFingerprint $localPackage ([int64]$record.size) $record.sha256 $record.package_code 'candidate Windows Installer LocalPackage'
        $candidateLocalPackages += $localPackage
    }
    $bundle = @(Get-BundleRegistration $campaign.candidate.setup.bundle_provider_key)
    Assert-Condition ($bundle.Count -eq 1) 'Candidate Bundle registration is missing or duplicated.'
    Assert-Condition ([string]$bundle[0].display_version -ceq [string]$campaign.candidate.version) 'Bundle DisplayVersion differs from the candidate.'
    Assert-Condition (@($bundle[0].upgrade_codes).Count -eq 1 -and [string]$bundle[0].upgrade_codes[0] -ceq [string]$campaign.fixed.BundleUpgradeCode) 'Bundle UpgradeCode differs from the fixed value.'
    Assert-Condition (-not (Test-Path -LiteralPath $campaign.paths.active_marker)) 'Candidate install created an active lease.'
    $serviceEvidence = Assert-ServiceConfiguration
    Add-Step 'candidate-installed-and-validated' 'passed' ([string]$campaign.candidate.version)

    Write-Phase 'awaiting-standard-user-smoke.json' 'awaiting-standard-user-smoke' 'ready' @{
        service_state = $serviceEvidence.state
        active_lease_present = $false
    }
    $smokeEvidence = Read-SmokePhase
    Assert-Condition ([string]$smokeEvidence.outcome -ceq 'passed') "Standard-user smoke failed: $($smokeEvidence.error)"
    Assert-Condition (-not (Test-Path -LiteralPath $campaign.paths.active_marker)) 'An active lease appeared during standard-user smoke.'
    Add-Step 'standard-user-smoke' 'passed' ([string]$smokeEvidence.owner_sid)
}
catch {
    $script:campaignError = ConvertTo-BoundedDiagnosticText $_.Exception.Message
    Add-Step 'campaign-body' 'failed' $script:campaignError
}
finally {
    try {
        if ($candidateInstallAttempted -or $installedCandidate -or (Get-ProductState $campaign.candidate.app_msi.product_code) -eq 5 -or (Get-ProductState $campaign.candidate.runtime_msi.product_code) -eq 5 -or @(Get-BundleRegistration $campaign.candidate.setup.bundle_provider_key).Count -gt 0) {
            Assert-Condition (-not (Test-Path -LiteralPath $campaign.paths.active_marker)) 'An active lease blocks safe candidate cleanup.'
            $uninstallEvidence = Invoke-CandidateUninstall
        }
    }
    catch {
        $cleanupErrors.Add($_.Exception.Message)
        Add-Step 'candidate-cleanup' 'failed' $_.Exception.Message
    }
}

$residualErrors = [Collections.Generic.List[string]]::new()
foreach ($check in @(
    [pscustomobject]@{ Name = 'App ProductCode'; Present = ((Get-ProductState $campaign.candidate.app_msi.product_code) -ne -1) },
    [pscustomobject]@{ Name = 'Runtime ProductCode'; Present = ((Get-ProductState $campaign.candidate.runtime_msi.product_code) -ne -1) },
    [pscustomobject]@{ Name = 'Bundle registration'; Present = (@(Get-BundleRegistration $campaign.candidate.setup.bundle_provider_key).Count -ne 0) },
    [pscustomobject]@{ Name = 'Activation service'; Present = ($null -ne (Get-Service -Name $serviceName -ErrorAction SilentlyContinue)) },
    [pscustomobject]@{ Name = 'App root'; Present = (Test-Path -LiteralPath $campaign.paths.app_root) },
    [pscustomobject]@{ Name = 'Runtime root'; Present = (Test-Path -LiteralPath $campaign.paths.runtime_root) },
    [pscustomobject]@{ Name = 'Runtime data root'; Present = (Test-Path -LiteralPath $campaign.paths.runtime_data_root) },
    [pscustomobject]@{ Name = 'Runtime seed'; Present = (Test-Path -LiteralPath $campaign.paths.runtime_seed_key) },
    [pscustomobject]@{ Name = 'active-lease.json'; Present = (Test-Path -LiteralPath $campaign.paths.active_marker) }
)) {
    if ($check.Present) { $residualErrors.Add("$($check.Name) remains") }
}
if (@(Get-RelatedProducts $campaign.fixed.AppUpgradeCode).Count -ne 0) { $residualErrors.Add('App UpgradeCode family is not empty') }
if (@(Get-RelatedProducts $campaign.fixed.RuntimeUpgradeCode).Count -ne 0) { $residualErrors.Add('Runtime UpgradeCode family is not empty') }
foreach ($localPackage in @($candidateLocalPackages | Sort-Object -Unique)) {
    if (Test-Path -LiteralPath $localPackage) { $residualErrors.Add("Candidate Windows Installer LocalPackage remains: $localPackage") }
}
$candidateProviderKeys = @(
    [string]$campaign.candidate.setup.bundle_provider_key,
    ("{0}_v{1}" -f $campaign.candidate.app_msi.product_code, $campaign.candidate.app_msi.product_version),
    ("{0}_v{1}" -f $campaign.candidate.runtime_msi.product_code, $campaign.candidate.runtime_msi.product_version)
)
foreach ($providerKey in $candidateProviderKeys) {
    if (Test-DependencyProvider $providerKey) { $residualErrors.Add("Candidate dependency provider remains: $providerKey") }
}
$candidateCacheDirectories = @(
    (Join-Path $campaign.paths.package_cache_root ([string]$campaign.candidate.setup.bundle_provider_key)),
    (Join-Path $campaign.paths.package_cache_root ("{0}v{1}" -f $campaign.candidate.app_msi.product_code, $campaign.candidate.app_msi.product_version)),
    (Join-Path $campaign.paths.package_cache_root ("{0}v{1}" -f $campaign.candidate.runtime_msi.product_code, $campaign.candidate.runtime_msi.product_version))
)
foreach ($cacheDirectory in $candidateCacheDirectories) {
    if (Test-Path -LiteralPath $cacheDirectory) { $residualErrors.Add("Candidate Package Cache directory remains: $cacheDirectory") }
}
if (Test-Path -LiteralPath $campaign.paths.common_start_menu_root) { $residualErrors.Add('Distraction Firewall common Start Menu folder remains') }
foreach ($errorMessage in $residualErrors) { $cleanupErrors.Add($errorMessage) }
if ($cleanupErrors.Count -eq 0) { Add-Step 'candidate-cleanup-and-residual-check' 'passed' 'No fixed product residuals detected.' }
$postPendingRename = Get-PendingRenameSnapshot
try { $verifiedBurnPendingDeletes = @(Assert-PendingRenameBaselinePlusBurn $pendingRenameBaseline $postPendingRename) }
catch {
    $verifiedBurnPendingDeletes = @()
    $cleanupErrors.Add($_.Exception.Message)
}
$postSystemBaseline = Get-SystemBaseline
try { Assert-SystemBaselineEquals $systemBaseline $postSystemBaseline 'Postflight' }
catch { $cleanupErrors.Add($_.Exception.Message) }
try { $ownedSystemPostflight = Assert-NoOwnedSystemObjects 'post-candidate' }
catch { $cleanupErrors.Add($_.Exception.Message) }

foreach ($file in Get-ChildItem -LiteralPath $stageEvidenceRoot -File -ErrorAction SilentlyContinue) {
    $destination = Join-Path $returnedEvidenceRoot $file.Name
    if (-not (Test-Path -LiteralPath $destination)) { Copy-Item -LiteralPath $file.FullName -Destination $destination }
}
Assert-PinnedEvidenceInputs
$stageCleanupError = $null
try {
    Remove-VerifiedStageTree $stageRoot
    $script:stageCreatedByCampaign = $false
}
catch {
    $stageCleanupError = $_.Exception.Message
    $cleanupErrors.Add("Protected staging teardown failed: $stageCleanupError")
}
$resultOutcome = if ($null -eq $script:campaignError -and $cleanupErrors.Count -eq 0 -and $null -ne $smokeEvidence -and [string]$smokeEvidence.outcome -ceq 'passed') { 'passed' } else { 'failed' }
$result = [ordered]@{
    schema = 'distraction-firewall/live-validation-result/v1'
    campaign_id = [string]$campaign.campaign_id
    outcome = $resultOutcome
    completed_at_utc = [DateTime]::UtcNow.ToString('o')
    candidate = [ordered]@{
        version = [string]$campaign.candidate.version
        source_commit_sha = [string]$campaign.source.commit_sha
        workflow_run_id = [string]$campaign.source.workflow_run_id
        workflow_run_attempt = [int]$campaign.source.workflow_run_attempt
        artifact_id = [string]$campaign.source.artifact_id
        artifact_digest = [string]$campaign.source.artifact_digest
        artifact_archive_size = [int64]$campaign.input_records.artifact_archive_size
        candidate_manifest_sha256 = [string]$campaign.input_records.candidate_manifest_sha256
        provenance_envelope_sha256 = [string]$campaign.input_records.provenance_envelope_sha256
        setup_sha256 = [string]$campaign.candidate.setup.sha256
        app_product_code = [string]$campaign.candidate.app_msi.product_code
        runtime_product_code = [string]$campaign.candidate.runtime_msi.product_code
        bundle_provider_key = [string]$campaign.candidate.setup.bundle_provider_key
    }
    tooling = [ordered]@{
        github_cli = $campaign.tooling.github_cli
    }
    owner_sid = [string]$campaign.owner_sid
    uac_prompts = 1
    lease_started = $false
    recovery = $recoveryEvidence
    service = $serviceEvidence
    standard_user_smoke = $smokeEvidence
    uninstall = $uninstallEvidence
    steps = @($steps)
    campaign_error = $script:campaignError
    cleanup_errors = @($cleanupErrors)
    protected_stage_teardown_error = $stageCleanupError
    residual_errors = @($residualErrors)
    pending_rename = [ordered]@{
        baseline = $pendingRenameBaseline
        postflight = $postPendingRename
        verified_burn_pending_deletes = @($verifiedBurnPendingDeletes)
    }
    system_baseline = [ordered]@{
        before = $systemBaseline
        after = $postSystemBaseline
        owned_objects_before = $ownedSystemPreflight
        owned_objects_after = $ownedSystemPostflight
    }
}
$resultPath = Join-Path $returnedEvidenceRoot 'campaign-result.json'
if (-not (Test-Path -LiteralPath $resultPath)) { Write-NewJson $resultPath $result }

$hashLines = @(
    Get-ChildItem -LiteralPath $returnedEvidenceRoot -File |
        Where-Object { $_.Name -cne 'evidence.sha256' } |
        Sort-Object Name |
        ForEach-Object { "$(Get-LowerSha256 $_.FullName)  $($_.Name)" }
)
[IO.File]::WriteAllLines((Join-Path $returnedEvidenceRoot 'evidence.sha256'), $hashLines, [Text.UTF8Encoding]::new($false))

if ($resultOutcome -cne 'passed') {
    [Console]::Error.WriteLine("Live-validation campaign failed: $script:campaignError; cleanup: $($cleanupErrors -join '; ')")
    exit 1
}
exit 0
