function Invoke-RecoveryIfPresent {
    if ($null -eq $campaign.recovery) {
        Assert-RuntimeAbsent
        Assert-AppAbsent
        return $null
    }
    Assert-ApprovedRecoveryCampaign
    Assert-AppAbsent
    $recovery = $campaign.recovery
    $record = $recovery.manifest.runtimeMsi
    Assert-Condition ([string]$record.upgradeCode -ceq [string]$campaign.fixed.RuntimeUpgradeCode) 'Recovery MSI left the fixed Runtime UpgradeCode family.'
    Assert-LeafFingerprint $recovery.manifest_path ([int64]$recovery.manifest_size) $recovery.manifest_sha256 '' 'recovery manifest'
    Assert-MsiRecordIdentity ([pscustomobject][ordered]@{
        size = [int64]$record.size; sha256 = [string]$record.sha256; authenticode_status = [string]$record.authenticodeStatus
        product_code = [string]$record.productCode; package_code = [string]$record.packageCode
        upgrade_code = [string]$record.upgradeCode; product_version = [string]$record.productVersion
    }) $recovery.msi_path 'recovery MSI source'
    $related = @(Get-RelatedProducts $campaign.fixed.RuntimeUpgradeCode)
    Assert-Condition (@($related | Where-Object { $_ -cne [string]$record.productCode }).Count -eq 0) 'An unapproved Runtime ProductCode is registered.'
    Assert-Condition ([string]$recovery.manifest.mode -ceq 'repair_then_uninstall') 'Recovery mode is not the single code-approved mode.'
    Assert-Condition ($related.Count -eq 1 -and $related[0] -ceq [string]$record.productCode) 'Recovery requires the exact Runtime ProductCode to be registered.'
    Assert-RecoveryProductInstalledDefault $record.productCode

    $preRecoveryLocalPackage = Get-LocalPackage $record.productCode
    Assert-Condition (-not [string]::IsNullOrWhiteSpace($preRecoveryLocalPackage)) 'Registered recovery ProductCode has no Windows Installer LocalPackage.'
    Assert-LocalPackageFingerprint $preRecoveryLocalPackage ([int64]$recovery.manifest.expectedInstalled.localPackage.sizeBytes) $recovery.manifest.expectedInstalled.localPackage.sha256 $recovery.manifest.expectedInstalled.packageCode 'pre-recovery Windows Installer LocalPackage'
    Assert-RecoveryMachinePreflight

    $preDiagnostic = Copy-ProtectedCleanupDiagnostic 'pre-recovery'
    $stagedRecovery = Join-Path $stagePayloadRoot 'recovery-runtime.msi'
    Copy-Item -LiteralPath $recovery.msi_path -Destination $stagedRecovery
    Assert-MsiRecordIdentity ([pscustomobject][ordered]@{
        size = [int64]$record.size; sha256 = [string]$record.sha256; authenticode_status = [string]$record.authenticodeStatus
        product_code = [string]$record.productCode; package_code = [string]$record.packageCode
        upgrade_code = [string]$record.upgradeCode; product_version = [string]$record.productVersion
    }) $stagedRecovery 'staged recovery MSI'
    $repairLog = Join-Path $stageEvidenceRoot 'recovery-recache.log'
    $repairArguments = @('/i', ('"{0}"' -f $stagedRecovery), 'REINSTALL=ALL', 'REINSTALLMODE=vomus', '/qn', '/norestart', 'REBOOT=ReallySuppress', '/L*v', ('"{0}"' -f $repairLog))
    $repairExit = Invoke-InstallerProcess $msiexec $repairArguments 'recovery-recache'
    Assert-Condition ($repairExit -eq 0) "Recovery recache failed with exit $repairExit."
    Assert-Condition ((Get-ProductState $record.productCode) -eq 5) 'Recovery MSI did not reach INSTALLSTATE_DEFAULT.'
    $recachedLocalPackage = Get-LocalPackage $record.productCode
    Assert-Condition (-not [string]::IsNullOrWhiteSpace($recachedLocalPackage)) 'Recached Runtime has no Windows Installer LocalPackage.'
    Assert-LocalPackageFingerprint $recachedLocalPackage ([int64]$record.size) $record.sha256 $record.packageCode 'recached Windows Installer LocalPackage'

    $uninstallLog = Join-Path $stageEvidenceRoot 'recovery-uninstall.log'
    $uninstallExit = Invoke-InstallerProcess $msiexec @('/x', [string]$record.productCode, '/qn', '/norestart', 'REBOOT=ReallySuppress', '/L*v', ('"{0}"' -f $uninstallLog)) 'recovery-uninstall'
    if ($uninstallExit -ne 0) {
        $null = Copy-ProtectedCleanupDiagnostic 'failed-recovery-uninstall'
        throw "Recovery Runtime uninstall failed with exit $uninstallExit."
    }
    Assert-RuntimeAbsent
    foreach ($localPackage in @($preRecoveryLocalPackage, $recachedLocalPackage) | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Sort-Object -Unique) {
        Assert-Condition (-not (Test-Path -LiteralPath $localPackage)) "Windows Installer LocalPackage remains after exact Runtime uninstall: $localPackage"
    }
    $orphanCacheEvidence = @(Remove-ExactOrphanPackageCaches)
    Add-Step 'recovery-verified-absent' 'passed' ([string]$record.productCode)
    return [pscustomobject][ordered]@{
        incident_id = [string]$recovery.manifest.incidentId
        mode = [string]$recovery.manifest.mode
        product_code = [string]$record.productCode
        preexisting_cleanup_diagnostic = $preDiagnostic
        recache_exit_code = $repairExit
        uninstall_exit_code = $uninstallExit
        pre_recovery_local_package = $preRecoveryLocalPackage
        recached_local_package = $recachedLocalPackage
        orphan_package_caches = $orphanCacheEvidence
    }
}

function Invoke-CandidateUninstall {
    $errors = [Collections.Generic.List[string]]::new()
    $setupLog = Join-Path $stageEvidenceRoot 'candidate-burn-uninstall.log'
    $setupExit = Invoke-InstallerProcess (Join-Path $stagePayloadRoot 'candidate-setup.exe') @('/uninstall', '/quiet', '/norestart', ('/log={0}' -f $setupLog)) 'candidate-burn-uninstall'
    if ($setupExit -ne 0) { $errors.Add("Burn uninstall exit $setupExit") }

    foreach ($record in @($campaign.candidate.app_msi, $campaign.candidate.runtime_msi)) {
        if ((Get-ProductState $record.product_code) -eq 5) {
            $role = if ([string]$record.product_code -ceq [string]$campaign.candidate.app_msi.product_code) { 'app' } else { 'runtime' }
            $fallbackLog = Join-Path $stageEvidenceRoot "candidate-$role-exact-fallback-uninstall.log"
            $exitCode = Invoke-InstallerProcess $msiexec @('/x', [string]$record.product_code, '/qn', '/norestart', 'REBOOT=ReallySuppress', '/L*v', ('"{0}"' -f $fallbackLog)) "candidate-$role-exact-fallback-uninstall"
            if ($exitCode -ne 0) {
                if ($role -ceq 'runtime') { $null = Copy-ProtectedCleanupDiagnostic 'failed-candidate-runtime-uninstall' }
                $errors.Add("Exact $role MSI fallback uninstall exit $exitCode")
            }
        }
    }
    foreach ($message in $errors) { $cleanupErrors.Add($message) }
    return [pscustomobject][ordered]@{
        burn_exit_code = $setupExit
        fallback_errors = @($errors)
    }
}

function Assert-CandidatePackageStatePreflight {
    $packageCacheRoot = [IO.Path]::GetFullPath((Join-Path $programData 'Package Cache')).TrimEnd('\')
    Assert-Condition ([IO.Path]::GetFullPath([string]$campaign.paths.package_cache_root).TrimEnd('\').Equals($packageCacheRoot, [StringComparison]::OrdinalIgnoreCase)) 'Candidate Package Cache root differs from the fixed CommonApplicationData path.'
    Assert-Condition (Test-Path -LiteralPath $packageCacheRoot) 'Candidate Package Cache root is missing; secure root creation is outside this campaign.'
    Assert-Condition (Test-Path -LiteralPath $packageCacheRoot -PathType Container) 'Candidate Package Cache root exists but is not a directory.'
    $packageCacheRootItem = Get-Item -LiteralPath $packageCacheRoot -Force
    Assert-Condition (($packageCacheRootItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -eq 0) 'Candidate Package Cache root is a reparse point.'
    Assert-NoBroadWriteAcl $packageCacheRoot 'candidate Package Cache root'
