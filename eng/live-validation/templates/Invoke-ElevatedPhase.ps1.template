function New-ProtectedStageDirectory {
    param([Parameter(Mandatory)][string]$Path)
    $expectedName = "DistractionFirewall-LiveValidation-{0}" -f $campaign.campaign_id
    $fullPath = [IO.Path]::GetFullPath($Path).TrimEnd('\')
    Assert-Condition ([IO.Path]::GetDirectoryName($fullPath).Equals([IO.Path]::GetFullPath($programData).TrimEnd('\'), [StringComparison]::OrdinalIgnoreCase)) 'Protected stage must be a direct ProgramData child.'
    Assert-Condition ([IO.Path]::GetFileName($fullPath) -ceq $expectedName) 'Protected stage name differs from the embedded campaign ID.'
    Assert-Condition (-not (Test-Path -LiteralPath $fullPath)) 'Protected campaign stage already exists.'
    $security = [Security.AccessControl.DirectorySecurity]::new()
    $security.SetAccessRuleProtection($true, $false)
    $inherit = [Security.AccessControl.InheritanceFlags]::ContainerInherit -bor [Security.AccessControl.InheritanceFlags]::ObjectInherit
    $propagation = [Security.AccessControl.PropagationFlags]::None
    foreach ($sidValue in @('S-1-5-18', 'S-1-5-32-544')) {
        $sid = [Security.Principal.SecurityIdentifier]::new($sidValue)
        $rule = [Security.AccessControl.FileSystemAccessRule]::new($sid, [Security.AccessControl.FileSystemRights]::FullControl, $inherit, $propagation, [Security.AccessControl.AccessControlType]::Allow)
        $security.AddAccessRule($rule)
    }
    $security.SetOwner([Security.Principal.SecurityIdentifier]::new('S-1-5-32-544'))
    $null = [IO.Directory]::CreateDirectory($fullPath, $security)
    $script:stageCreatedByCampaign = $true
    $created = Get-Item -LiteralPath $fullPath -Force
    Assert-Condition (($created.Attributes -band [IO.FileAttributes]::ReparsePoint) -eq 0) 'Protected stage was created as a reparse point.'
    $owner = $created.GetAccessControl().GetOwner([Security.Principal.SecurityIdentifier]).Value
    Assert-Condition ($owner -in @('S-1-5-18', 'S-1-5-32-544')) 'Protected stage owner is not SYSTEM/Administrators.'
    Assert-NoBroadWriteAcl $fullPath 'protected campaign stage'
}

function Remove-VerifiedStageTree {
    param([Parameter(Mandatory)][string]$Path)
    $expectedParent = [IO.Path]::GetFullPath($programData).TrimEnd('\')
    $fullPath = [IO.Path]::GetFullPath($Path).TrimEnd('\')
    Assert-Condition ([IO.Path]::GetDirectoryName($fullPath).Equals($expectedParent, [StringComparison]::OrdinalIgnoreCase)) 'Refusing to remove a stage outside the fixed LiveValidation root.'
    Assert-Condition ([IO.Path]::GetFileName($fullPath) -ceq ("DistractionFirewall-LiveValidation-{0}" -f $campaign.campaign_id)) 'Refusing to remove a stage with a different campaign ID.'
    if (-not (Test-Path -LiteralPath $fullPath -PathType Container)) { return }
    $rootItem = Get-Item -LiteralPath $fullPath -Force
    Assert-Condition (($rootItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -eq 0) 'Refusing to remove a reparse-point stage.'
    $reparse = @(Get-ChildItem -LiteralPath $fullPath -Force -Recurse | Where-Object { ($_.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0 })
    Assert-Condition ($reparse.Count -eq 0) 'Refusing to remove a stage containing reparse points.'
    Remove-Item -LiteralPath $fullPath -Force -Recurse
}

function Get-MsiIdentity {
    param([Parameter(Mandatory)][string]$Path)
    $installer = New-Object -ComObject WindowsInstaller.Installer
    $database = $null
    try {
        $database = $installer.OpenDatabase($Path, 0)
        $values = [ordered]@{}
        foreach ($name in @('ProductCode', 'UpgradeCode', 'ProductVersion')) {
            $view = $database.OpenView("SELECT ``Value`` FROM ``Property`` WHERE ``Property``='$name'")
            try {
                $null = $view.Execute()
                $record = $view.Fetch()
                Assert-Condition ($null -ne $record) "MSI property '$name' is absent."
                try { $values[$name] = [string]$record.StringData(1) }
                finally { [void][Runtime.InteropServices.Marshal]::FinalReleaseComObject($record) }
            }
            finally {
                $null = $view.Close()
                [void][Runtime.InteropServices.Marshal]::FinalReleaseComObject($view)
            }
        }
        $summary = $database.SummaryInformation(0)
        try { $packageCode = [string]$summary.Property(9) }
        finally { [void][Runtime.InteropServices.Marshal]::FinalReleaseComObject($summary) }
        return [pscustomobject][ordered]@{
            product_code = $values.ProductCode.ToUpperInvariant()
            upgrade_code = $values.UpgradeCode.ToUpperInvariant()
            product_version = $values.ProductVersion
            package_code = $packageCode.ToUpperInvariant()
        }
    }
    finally {
        if ($null -ne $database) { [void][Runtime.InteropServices.Marshal]::FinalReleaseComObject($database) }
        [void][Runtime.InteropServices.Marshal]::FinalReleaseComObject($installer)
    }
}

$nativeTypeName = 'DistractionFirewall.LiveValidation.NativeInspection'
if ($null -eq ($nativeTypeName -as [type])) {
    Add-Type -TypeDefinition @'
using System;
using System.ComponentModel;
using System.Collections.Generic;
using System.Runtime.InteropServices;
using System.Text;

namespace DistractionFirewall.LiveValidation
{
    public sealed class FailureActions
    {
        public uint ResetPeriodSeconds { get; set; }
        public int[] ActionTypes { get; set; }
        public uint[] ActionDelaysMilliseconds { get; set; }
        public bool ApplyOnNonCrashFailures { get; set; }
    }

    public static class NativeInspection
    {
        private const uint ErrorSuccess = 0;
        private const uint ErrorNoMoreItems = 259;
        private const uint ScManagerConnect = 0x0001;
        private const uint ServiceQueryConfig = 0x0001;
        private const uint ServiceConfigFailureActions = 2;
        private const uint ServiceConfigFailureActionsFlag = 4;
        private const int ErrorInsufficientBuffer = 122;
        private const uint FwpErrorProviderNotFound = 0x80320005;
        private const uint FwpErrorSubLayerNotFound = 0x80320007;

        [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
        private struct ServiceFailureActions
        {
            public uint ResetPeriod;
            public IntPtr RebootMessage;
            public IntPtr Command;
            public uint ActionCount;
            public IntPtr Actions;
        }

        [StructLayout(LayoutKind.Sequential)]
        private struct ServiceAction { public int Type; public uint Delay; }

        [StructLayout(LayoutKind.Sequential)]
        private struct ServiceFailureActionsFlag
        {
            [MarshalAs(UnmanagedType.Bool)] public bool ApplyOnNonCrashFailures;
        }

        [DllImport("msi.dll", CharSet = CharSet.Unicode)]
        private static extern uint MsiEnumRelatedProductsW(string upgradeCode, uint reserved, uint index, StringBuilder productCode);
        [DllImport("msi.dll", CharSet = CharSet.Unicode)]
        private static extern int MsiQueryProductStateW(string productCode);
        [DllImport("msi.dll", CharSet = CharSet.Unicode)]
        private static extern uint MsiGetProductInfoW(string productCode, string property, StringBuilder value, ref uint valueLength);
        [DllImport("advapi32.dll", CharSet = CharSet.Unicode, SetLastError = true, ExactSpelling = true)]
        private static extern IntPtr OpenSCManagerW(string machineName, string databaseName, uint desiredAccess);
        [DllImport("advapi32.dll", CharSet = CharSet.Unicode, SetLastError = true, ExactSpelling = true)]
        private static extern IntPtr OpenServiceW(IntPtr manager, string serviceName, uint desiredAccess);
        [DllImport("advapi32.dll", CharSet = CharSet.Unicode, SetLastError = true, ExactSpelling = true)]
        [return: MarshalAs(UnmanagedType.Bool)]
        private static extern bool QueryServiceConfig2W(IntPtr service, uint level, IntPtr buffer, uint size, out uint needed);
        [DllImport("advapi32.dll", SetLastError = true)]
        [return: MarshalAs(UnmanagedType.Bool)]
        private static extern bool CloseServiceHandle(IntPtr handle);
        [DllImport("fwpuclnt.dll", CharSet = CharSet.Unicode)]
        private static extern uint FwpmEngineOpen0(string serverName, uint authnService, IntPtr authIdentity, IntPtr session, out IntPtr engineHandle);
        [DllImport("fwpuclnt.dll")]
        private static extern uint FwpmEngineClose0(IntPtr engineHandle);
        [DllImport("fwpuclnt.dll")]
        private static extern uint FwpmProviderGetByKey0(IntPtr engineHandle, ref Guid key, out IntPtr provider);
        [DllImport("fwpuclnt.dll")]
        private static extern uint FwpmSubLayerGetByKey0(IntPtr engineHandle, ref Guid key, out IntPtr subLayer);
        [DllImport("fwpuclnt.dll")]
        private static extern void FwpmFreeMemory0(ref IntPtr pointer);

        public static string[] EnumRelatedProducts(string upgradeCode)
        {
            List<string> products = new List<string>();
            for (uint index = 0; ; index++)
            {
                StringBuilder product = new StringBuilder(39);
                uint error = MsiEnumRelatedProductsW(upgradeCode, 0, index, product);
                if (error == ErrorNoMoreItems) return products.ToArray();
                if (error != ErrorSuccess) throw new Win32Exception((int)error, "MsiEnumRelatedProductsW failed.");
                products.Add(product.ToString().ToUpperInvariant());
            }
        }

        public static int QueryProductState(string productCode) { return MsiQueryProductStateW(productCode); }

        public static string GetProductInfo(string productCode, string property)
        {
            uint length = 0;
            uint error = MsiGetProductInfoW(productCode, property, null, ref length);
            if (error == 1605) return null;
            if (error != 234 && error != ErrorSuccess) throw new Win32Exception((int)error, "MsiGetProductInfoW size query failed.");
            uint capacity = checked(length + 1);
            StringBuilder value = new StringBuilder(checked((int)capacity));
            error = MsiGetProductInfoW(productCode, property, value, ref capacity);
            if (error != ErrorSuccess) throw new Win32Exception((int)error, "MsiGetProductInfoW failed.");
            return value.ToString();
        }

        public static bool WfpProviderExists(Guid key) { return WfpObjectExists(key, false); }
        public static bool WfpSubLayerExists(Guid key) { return WfpObjectExists(key, true); }

        private static bool WfpObjectExists(Guid key, bool subLayer)
        {
            IntPtr engine;
            uint error = FwpmEngineOpen0(null, 0, IntPtr.Zero, IntPtr.Zero, out engine);
            if (error != ErrorSuccess) throw new Win32Exception((int)error, "FwpmEngineOpen0 failed.");
            try
            {
                IntPtr value;
                error = subLayer ? FwpmSubLayerGetByKey0(engine, ref key, out value) : FwpmProviderGetByKey0(engine, ref key, out value);
                uint missing = subLayer ? FwpErrorSubLayerNotFound : FwpErrorProviderNotFound;
                if (error == missing) return false;
                if (error != ErrorSuccess) throw new Win32Exception((int)error, "WFP object query failed.");
                try { return true; }
                finally { FwpmFreeMemory0(ref value); }
            }
            finally { FwpmEngineClose0(engine); }
        }

        public static FailureActions ReadFailureActions(string serviceName)
        {
            IntPtr manager = OpenSCManagerW(null, null, ScManagerConnect);
            if (manager == IntPtr.Zero) throw new Win32Exception(Marshal.GetLastWin32Error(), "OpenSCManagerW failed.");
            try
            {
                IntPtr service = OpenServiceW(manager, serviceName, ServiceQueryConfig);
                if (service == IntPtr.Zero) throw new Win32Exception(Marshal.GetLastWin32Error(), "OpenServiceW failed.");
                try
                {
                    IntPtr actionsBuffer = QueryBuffer(service, ServiceConfigFailureActions);
                    try
                    {
                        ServiceFailureActions actions = (ServiceFailureActions)Marshal.PtrToStructure(actionsBuffer, typeof(ServiceFailureActions));
                        if (actions.ActionCount > 32) throw new InvalidOperationException("Unreasonable service failure-action count.");
                        int count = checked((int)actions.ActionCount);
                        int[] types = new int[count];
                        uint[] delays = new uint[count];
                        int size = Marshal.SizeOf(typeof(ServiceAction));
                        for (int i = 0; i < count; i++)
                        {
                            ServiceAction action = (ServiceAction)Marshal.PtrToStructure(IntPtr.Add(actions.Actions, checked(i * size)), typeof(ServiceAction));
                            types[i] = action.Type;
                            delays[i] = action.Delay;
                        }
                        IntPtr flagBuffer = QueryBuffer(service, ServiceConfigFailureActionsFlag);
                        try
                        {
                            ServiceFailureActionsFlag flag = (ServiceFailureActionsFlag)Marshal.PtrToStructure(flagBuffer, typeof(ServiceFailureActionsFlag));
                            return new FailureActions { ResetPeriodSeconds = actions.ResetPeriod, ActionTypes = types, ActionDelaysMilliseconds = delays, ApplyOnNonCrashFailures = flag.ApplyOnNonCrashFailures };
                        }
                        finally { Marshal.FreeHGlobal(flagBuffer); }
                    }
                    finally { Marshal.FreeHGlobal(actionsBuffer); }
                }
                finally { CloseServiceHandle(service); }
            }
            finally { CloseServiceHandle(manager); }
        }

        private static IntPtr QueryBuffer(IntPtr service, uint level)
        {
            uint needed;
            bool first = QueryServiceConfig2W(service, level, IntPtr.Zero, 0, out needed);
            int error = Marshal.GetLastWin32Error();
            if (first || error != ErrorInsufficientBuffer || needed == 0) throw new Win32Exception(error, "QueryServiceConfig2W size query failed.");
            IntPtr buffer = Marshal.AllocHGlobal(checked((int)needed));
            if (!QueryServiceConfig2W(service, level, buffer, needed, out needed))
            {
                error = Marshal.GetLastWin32Error();
                Marshal.FreeHGlobal(buffer);
                throw new Win32Exception(error, "QueryServiceConfig2W failed.");
            }
            return buffer;
        }
    }
}
'@
}

if ($null -eq ('DistractionFirewall.LiveValidation.MandatoryIntegrityInspection' -as [type])) {
    Microsoft.PowerShell.Utility\Add-Type -TypeDefinition @'
using System;
using System.ComponentModel;
using System.Runtime.InteropServices;

namespace DistractionFirewall.LiveValidation
{
    public static class MandatoryIntegrityInspection
    {
        private const uint SeFileObject = 1;
        private const uint LabelSecurityInformation = 0x00000010;

        [DllImport("advapi32.dll", CharSet = CharSet.Unicode, ExactSpelling = true)]
        private static extern uint GetNamedSecurityInfoW(
            string objectName,
            uint objectType,
            uint securityInformation,
            IntPtr owner,
            IntPtr group,
            IntPtr dacl,
            out IntPtr sacl,
            out IntPtr securityDescriptor);

        [DllImport("advapi32.dll", CharSet = CharSet.Unicode, ExactSpelling = true, SetLastError = true)]
        private static extern bool ConvertSecurityDescriptorToStringSecurityDescriptorW(
            IntPtr securityDescriptor,
            uint requestedRevision,
            uint securityInformation,
            out IntPtr stringSecurityDescriptor,
            out uint stringSecurityDescriptorLength);

        [DllImport("kernel32.dll", ExactSpelling = true)]
        private static extern IntPtr LocalFree(IntPtr memory);

        public static string GetLabelSddl(string path)
        {
            IntPtr sacl;
            IntPtr securityDescriptor;
            uint result = GetNamedSecurityInfoW(
                path,
                SeFileObject,
                LabelSecurityInformation,
                IntPtr.Zero,
                IntPtr.Zero,
                IntPtr.Zero,
                out sacl,
                out securityDescriptor);
            if (result != 0)
            {
                throw new Win32Exception((int)result);
            }

            try
            {
                IntPtr text;
                uint textLength;
                if (!ConvertSecurityDescriptorToStringSecurityDescriptorW(
                    securityDescriptor,
                    1,
                    LabelSecurityInformation,
                    out text,
                    out textLength))
                {
                    throw new Win32Exception(Marshal.GetLastWin32Error());
                }

                try
                {
                    return Marshal.PtrToStringUni(text) ?? string.Empty;
                }
                finally
                {
                    LocalFree(text);
                }
            }
            finally
            {
                LocalFree(securityDescriptor);
            }
        }
    }
}
'@
}

function Get-RelatedProducts {
    param([Parameter(Mandatory)][string]$UpgradeCode)
    return @([DistractionFirewall.LiveValidation.NativeInspection]::EnumRelatedProducts($UpgradeCode) | Sort-Object)
}

function Get-ProductState {
    param([Parameter(Mandatory)][string]$ProductCode)
    return [DistractionFirewall.LiveValidation.NativeInspection]::QueryProductState($ProductCode)
}

function Get-LocalPackage {
    param([Parameter(Mandatory)][string]$ProductCode)
    return [DistractionFirewall.LiveValidation.NativeInspection]::GetProductInfo($ProductCode, 'LocalPackage')
}

function Get-InstalledProductVersion {
    param([Parameter(Mandatory)][string]$ProductCode)
    return [DistractionFirewall.LiveValidation.NativeInspection]::GetProductInfo($ProductCode, 'VersionString')
}

function Test-DependencyProvider {
    param([Parameter(Mandatory)][string]$ProviderKey)
    $subKey = "SOFTWARE\Classes\Installer\Dependencies\$ProviderKey"
    foreach ($view in @([Microsoft.Win32.RegistryView]::Registry64, [Microsoft.Win32.RegistryView]::Registry32)) {
        $base = [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine, $view)
        try {
            $key = $base.OpenSubKey($subKey, $false)
            if ($null -ne $key) { $key.Dispose(); return $true }
        }
        finally { $base.Dispose() }
    }
    return $false
}

function Assert-LocalPackageFingerprint {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][int64]$Size,
        [Parameter(Mandatory)][string]$Sha256,
        [Parameter(Mandatory)][string]$PackageCode,
        [Parameter(Mandatory)][string]$Description
    )
    $installerRoot = [IO.Path]::GetFullPath($script:installerRoot).TrimEnd('\')
    $fullPath = [IO.Path]::GetFullPath($Path)
    Assert-Condition ([IO.Path]::GetDirectoryName($fullPath).Equals($installerRoot, [StringComparison]::OrdinalIgnoreCase)) "$Description is outside the fixed Windows Installer cache root."
    Assert-LeafFingerprint $fullPath $Size $Sha256 '' $Description
    Assert-PrivilegedPathAcl $fullPath "$Description protected file"
    $identity = Get-MsiIdentity $fullPath
    Assert-Condition ($identity.package_code -ceq $PackageCode) "$Description PackageCode mismatch."
}

function Assert-NoBroadWriteAcl {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$Description
    )
    Assert-PrivilegedPathAcl $Path $Description
}

function Get-ValidatedOrphanPackageCache {
    param(
        [Parameter(Mandatory)]$Cache,
        [Parameter(Mandatory)][string]$Phase
    )
    $packageCacheRoot = [IO.Path]::GetFullPath((Join-Path $programData 'Package Cache')).TrimEnd('\')
    $packageCacheRootItem = Get-Item -LiteralPath $packageCacheRoot -Force
    Assert-Condition (($packageCacheRootItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -eq 0) "$Phase Package Cache root is a reparse point."
    Assert-NoBroadWriteAcl $packageCacheRoot "$Phase Package Cache root"
    $directory = [IO.Path]::GetFullPath((Join-Path $packageCacheRoot ([string]$Cache.directoryName)))
    Assert-Condition ([IO.Path]::GetDirectoryName($directory).Equals($packageCacheRoot, [StringComparison]::OrdinalIgnoreCase)) "$Phase orphan cache directory escaped the fixed Package Cache root."
    if (-not (Test-Path -LiteralPath $directory)) {
        return [pscustomobject][ordered]@{ present = $false; directory = $directory; file = $null }
    }
    Assert-Condition (Test-Path -LiteralPath $directory -PathType Container) "$Phase orphan package cache path exists but is not a directory."
    $directoryItem = Get-Item -LiteralPath $directory -Force
    Assert-Condition (($directoryItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -eq 0) "$Phase orphan package cache directory is a reparse point."
    Assert-NoBroadWriteAcl $directory "$Phase orphan package cache directory"
    Assert-Condition (@(Get-ChildItem -LiteralPath $directory -Directory -Force).Count -eq 0) "$Phase orphan package cache contains a nested directory."
    $files = @(Get-ChildItem -LiteralPath $directory -File -Force)
    Assert-Condition ($files.Count -eq 1 -and $files[0].Name -ceq [string]$Cache.payload.fileName) "$Phase orphan package cache is not the exact single-file layout."
    Assert-Condition (($files[0].Attributes -band [IO.FileAttributes]::ReparsePoint) -eq 0) "$Phase orphan package cache MSI is a reparse point."
    Assert-NoBroadWriteAcl $files[0].FullName "$Phase orphan package cache MSI"
    Assert-LeafFingerprint $files[0].FullName ([int64]$Cache.payload.sizeBytes) $Cache.payload.sha256 '' "$Phase orphan package cache MSI"
    $identity = Get-MsiIdentity $files[0].FullName
    Assert-Condition ($identity.product_code -ceq [string]$Cache.productCode -and $identity.package_code -ceq [string]$Cache.packageCode -and $identity.upgrade_code -ceq [string]$Cache.upgradeCode -and $identity.product_version -ceq [string]$Cache.productVersion) "$Phase orphan package cache MSI identity differs from the manifest."
    return [pscustomobject][ordered]@{ present = $true; directory = $directory; file = $files[0] }
}

function Assert-RecoveryMachinePreflight {
    if ($null -eq $campaign.recovery) { return }
    $record = $campaign.recovery.manifest.runtimeMsi
    Assert-RecoveryProductInstalledDefault $record.productCode
    $installedVersion = Get-InstalledProductVersion $record.productCode
    Assert-Condition (-not [string]::IsNullOrWhiteSpace($installedVersion) -and $installedVersion -ceq [string]$campaign.recovery.manifest.expectedInstalled.productVersion) "Recovery installed ProductVersion differs from the exact incident state: $installedVersion"
    $null = Assert-ServiceConfiguration
    Assert-LeafFingerprint $campaign.paths.service_exe ([int64]$approvedRecoveryExistingService.size) $approvedRecoveryExistingService.sha256 $approvedRecoveryExistingService.authenticodeStatus 'code-approved pre-recovery activation service executable'
    $null = Assert-NoOwnedSystemObjects 'pre-recovery'
    foreach ($bundleKey in @($campaign.recovery.manifest.orphanBundleProviderKeys)) {
        Assert-Condition (@(Get-BundleRegistration $bundleKey).Count -eq 0) "Recovery preflight found the orphan Bundle registered: $bundleKey"
        Assert-Condition (-not (Test-DependencyProvider $bundleKey)) "Recovery preflight found the orphan Bundle dependency provider: $bundleKey"
        $bundleCache = [IO.Path]::GetFullPath((Join-Path $campaign.paths.package_cache_root $bundleKey))
        Assert-Condition ([IO.Path]::GetDirectoryName($bundleCache).Equals([IO.Path]::GetFullPath($campaign.paths.package_cache_root).TrimEnd('\'), [StringComparison]::OrdinalIgnoreCase)) 'Recovery Bundle cache escaped Package Cache root.'
        Assert-Condition (-not (Test-Path -LiteralPath $bundleCache)) "Recovery preflight found an unapproved orphan Bundle cache: $bundleCache"
    }
    foreach ($cache in @($campaign.recovery.manifest.orphanPackageCaches)) {
        $state = Get-ProductState $cache.productCode
        if ([string]$cache.productCode -ceq [string]$record.productCode) {
            Assert-Condition ($state -eq 5) "Recovery Runtime cache ProductCode is not INSTALLSTATE_DEFAULT: $state"
        }
        else {
            Assert-Condition ($state -eq -1) "Recovery preflight found an old ProductCode registered: $($cache.productCode); state $state"
            Assert-Condition ((Get-RelatedProducts $cache.upgradeCode) -notcontains [string]$cache.productCode) "Recovery preflight found an old ProductCode in its UpgradeCode family: $($cache.productCode)"
        }
        Assert-Condition (-not (Test-DependencyProvider $cache.dependencyProviderKey)) "Recovery preflight found an orphan package dependency provider: $($cache.dependencyProviderKey)"
        $null = Get-ValidatedOrphanPackageCache $cache 'recovery preflight'
    }
}

function Remove-ExactOrphanPackageCaches {
    if ($null -eq $campaign.recovery) { return @() }
    $removed = @()
    foreach ($bundleKey in @($campaign.recovery.manifest.orphanBundleProviderKeys)) {
        Assert-Condition (@(Get-BundleRegistration $bundleKey).Count -eq 0) "Orphan Bundle provider is still registered: $bundleKey"
        Assert-Condition (-not (Test-DependencyProvider $bundleKey)) "Orphan Bundle dependency provider is still registered: $bundleKey"
    }
    foreach ($cache in @($campaign.recovery.manifest.orphanPackageCaches)) {
        Assert-Condition ((Get-ProductState $cache.productCode) -eq -1) "Orphan cache ProductCode is still registered: $($cache.productCode)"
        Assert-Condition ((Get-RelatedProducts $cache.upgradeCode) -notcontains [string]$cache.productCode) "Orphan cache ProductCode remains in its UpgradeCode family: $($cache.productCode)"
        Assert-Condition (-not (Test-DependencyProvider $cache.dependencyProviderKey)) "Orphan package dependency provider is still registered: $($cache.dependencyProviderKey)"
        $inspection = Get-ValidatedOrphanPackageCache $cache 'post-uninstall cleanup'
        if (-not [bool]$inspection.present) {
            $removed += [ordered]@{ directory = [string]$inspection.directory; outcome = 'already-absent' }
            continue
        }
        # Recheck immediately before a narrow move into the administrator-only
        # stage. Once moved, deletion no longer races a user-writable location.
        $freshInspection = Get-ValidatedOrphanPackageCache $cache 'immediate pre-removal recheck'
        Assert-Condition ([bool]$freshInspection.present) 'Orphan package cache disappeared during the removal boundary.'
        $directory = [string]$freshInspection.directory
        $freshItem = $freshInspection.file
        $quarantinePath = Join-Path $stagePayloadRoot ("orphan-cache-{0}.msi" -f ([Guid]::NewGuid().ToString('N')))
        Move-Item -LiteralPath $freshItem.FullName -Destination $quarantinePath
        Assert-LeafFingerprint $quarantinePath ([int64]$cache.payload.sizeBytes) $cache.payload.sha256 '' 'quarantined orphan package cache MSI'
        $quarantineIdentity = Get-MsiIdentity $quarantinePath
        Assert-Condition ($quarantineIdentity.product_code -ceq [string]$cache.productCode -and $quarantineIdentity.package_code -ceq [string]$cache.packageCode) 'Quarantined orphan cache identity changed.'
        Remove-Item -LiteralPath $quarantinePath -Force
        Remove-Item -LiteralPath $directory -Force
        Assert-Condition (-not (Test-Path -LiteralPath $directory)) 'Exact orphan package cache removal did not complete.'
        $removed += [ordered]@{ directory = $directory; outcome = 'removed'; payload_sha256 = [string]$cache.payload.sha256 }
    }
    return @($removed)
}

function Get-BundleRegistration {
    param([Parameter(Mandatory)][string]$BundleProviderKey)
    $subKey = "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\$BundleProviderKey"
    $records = @()
    foreach ($view in @([Microsoft.Win32.RegistryView]::Registry64, [Microsoft.Win32.RegistryView]::Registry32)) {
        $base = [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine, $view)
        try {
            $key = $base.OpenSubKey($subKey, $false)
            if ($null -eq $key) { continue }
            try {
                $rawUpgrade = $key.GetValue('BundleUpgradeCode', $null)
                $upgrades = if ($rawUpgrade -is [Array]) { @($rawUpgrade | ForEach-Object { [string]$_ }) } elseif ($null -ne $rawUpgrade) { @([string]$rawUpgrade) } else { @() }
                $records += [pscustomobject][ordered]@{
                    registry_view = $view.ToString()
                    display_version = [string]$key.GetValue('DisplayVersion', $null)
                    cache_path = [string]$key.GetValue('BundleCachePath', $null)
                    upgrade_codes = @($upgrades)
                }
            }
            finally { $key.Dispose() }
        }
        finally { $base.Dispose() }
    }
    return @($records)
}

function Invoke-InstallerProcess {
    param(
