function Assert-Condition {
    param(
        [Parameter(Mandatory)][bool]$Condition,
        [Parameter(Mandatory)][string]$Message
    )
    if (-not $Condition) { throw $Message }
}

function Read-StrictUtf8Json {
    param([Parameter(Mandatory)][string]$Path)

    $strictUtf8 = [Text.UTF8Encoding]::new($false, $true)
    $text = $strictUtf8.GetString([IO.File]::ReadAllBytes($Path))
    if ($text.Length -gt 0 -and $text[0] -eq [char]0xFEFF) {
        $text = $text.Substring(1)
    }
    return $text | ConvertFrom-Json
}

function Assert-AcceptableMandatoryIntegritySddl {
    param(
        [AllowEmptyString()][Parameter(Mandatory)][string]$Sddl,
        [Parameter(Mandatory)][string]$Description
    )

    # LABEL_SECURITY_INFORMATION returns an empty string when no explicit label
    # exists. Windows then applies the effective Medium object integrity level.
    if ([string]::IsNullOrEmpty($Sddl)) { return }
    try { $descriptor = [Security.AccessControl.RawSecurityDescriptor]::new($Sddl) }
    catch { throw "$Description mandatory integrity label could not be parsed." }
    $mandatoryAces = @()
    if ($null -ne $descriptor.SystemAcl) {
        for ($index = 0; $index -lt $descriptor.SystemAcl.Count; $index++) {
            $ace = $descriptor.SystemAcl[$index]
            if ([int]$ace.AceType -eq 17) { $mandatoryAces += $ace }
        }
    }
    if ($mandatoryAces.Count -eq 0) { return }
    Assert-Condition ($mandatoryAces.Count -eq 1) "$Description has a conflicting mandatory integrity label set."
    $binary = New-Object byte[] $mandatoryAces[0].BinaryLength
    $mandatoryAces[0].GetBinaryForm($binary, 0)
    Assert-Condition ($binary.Length -ge 20) "$Description mandatory integrity label is malformed."
    $policyMask = [BitConverter]::ToUInt32($binary, 4)
    Assert-Condition ($policyMask -in @([uint32]1, [uint32]3, [uint32]5, [uint32]7)) "$Description mandatory integrity policy is unknown or permits write-up."
    try { $labelSid = [Security.Principal.SecurityIdentifier]::new($binary, 8) }
    catch { throw "$Description mandatory integrity SID could not be parsed." }
    Assert-Condition ($binary.Length -eq (8 + $labelSid.BinaryLength)) "$Description mandatory integrity label has trailing data."
    Assert-Condition ($labelSid.Value -in @('S-1-16-8192', 'S-1-16-12288', 'S-1-16-16384')) "$Description has an untrusted, low, or unknown mandatory integrity level: $($labelSid.Value)"
}

function Assert-PrivilegedPathAcl {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$Description
    )
    $acl = Microsoft.PowerShell.Security\Get-Acl -LiteralPath $Path
    Assert-AcceptableMandatoryIntegritySddl ([DistractionFirewall.LiveValidation.MandatoryIntegrityInspection]::GetLabelSddl([IO.Path]::GetFullPath($Path))) $Description
    $trustedInstaller = 'S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464'
    $trustedWriterSids = @('S-1-5-18', 'S-1-5-32-544', $trustedInstaller)
    $ownerSid = $acl.GetOwner([Security.Principal.SecurityIdentifier]).Value
    Assert-Condition ($ownerSid -in $trustedWriterSids) "$Description owner is not SYSTEM, Administrators, or TrustedInstaller: $ownerSid"
    $dangerousRightsMask = [int64]0x500D0156
    $descriptor = [Security.AccessControl.RawSecurityDescriptor]::new($acl.GetSecurityDescriptorSddlForm([Security.AccessControl.AccessControlSections]::All))
    for ($index = 0; $index -lt $descriptor.DiscretionaryAcl.Count; $index++) {
        $ace = $descriptor.DiscretionaryAcl[$index]
        if ($ace -isnot [Security.AccessControl.QualifiedAce] -or $ace.AceQualifier -ne [Security.AccessControl.AceQualifier]::AccessAllowed) { continue }
        if (([int]$ace.AceFlags -band [int][Security.AccessControl.AceFlags]::InheritOnly) -ne 0) { continue }
        $rawRights = [int64][int32]$ace.AccessMask
        if ($rawRights -lt 0) { $rawRights += 4294967296 }
        if (($rawRights -band $dangerousRightsMask) -ne 0) {
            $sid = $ace.SecurityIdentifier.Value
            Assert-Condition ($sid -in $trustedWriterSids) "$Description grants dangerous write/delete/ACL rights to non-privileged SID $sid."
        }
    }
}

function Assert-TrustedSystemBinary {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$Description
    )
    $fullPath = [IO.Path]::GetFullPath($Path)
    Assert-Condition ($fullPath.StartsWith($windowsDirectory + '\', [StringComparison]::OrdinalIgnoreCase)) "$Description escaped the native Windows directory."
    foreach ($trustedPath in @($windowsDirectory, $systemDirectory, $trustedPowerShellRoot, $trustedPowerShellHome, $trustedPowerShellModuleRoot, $fullPath) | Select-Object -Unique) {
        Assert-Condition (Test-Path -LiteralPath $trustedPath) "$Description trusted path is missing: $trustedPath"
        $item = Microsoft.PowerShell.Management\Get-Item -LiteralPath $trustedPath -Force
        Assert-Condition (($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -eq 0) "$Description trusted path is a reparse point: $trustedPath"
        Assert-PrivilegedPathAcl $trustedPath "$Description trusted path"
    }
    Assert-Condition (Test-Path -LiteralPath $fullPath -PathType Leaf) "$Description is missing: $fullPath"
    $signature = Microsoft.PowerShell.Security\Get-AuthenticodeSignature -LiteralPath $fullPath
    $microsoftWindowsSubject = 'CN=Microsoft Windows, O=Microsoft Corporation, L=Redmond, S=Washington, C=US'
    Assert-Condition ($signature.Status.ToString() -ceq 'Valid' -and $null -ne $signature.SignerCertificate) "$Description Authenticode signature is invalid."
    Assert-Condition ([string]$signature.SignerCertificate.Subject -ceq $microsoftWindowsSubject) "$Description publisher is not Microsoft Windows."
}

function Assert-ApprovedRecoveryCampaign {
    if ($null -eq $campaign.recovery) { return }

    Assert-Condition ([string]$campaign.recovery.manifest_sha256 -ceq $approvedRecoveryManifestSha256) 'Embedded recovery manifest hash is not code-approved.'
    Assert-Condition ([string]$campaign.recovery.approved_manifest_sha256 -ceq $approvedRecoveryManifestSha256) 'Embedded approved recovery hash is not code-owned.'
    $actual = $campaign.recovery.manifest | ConvertTo-Json -Depth 12 -Compress
    $expected = $approvedRecoveryManifest | ConvertTo-Json -Depth 12 -Compress
    Assert-Condition ($actual -ceq $expected) 'Embedded recovery manifest is outside the code-approved incident allowlist.'
}

