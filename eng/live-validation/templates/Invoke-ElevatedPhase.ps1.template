    $runtimeRoot = [IO.Path]::GetFullPath([string]$campaign.paths.runtime_root).TrimEnd('\')
    $activationRoot = [IO.Path]::GetFullPath([IO.Path]::GetDirectoryName([string]$campaign.paths.service_exe)).TrimEnd('\')
    $servicePath = [IO.Path]::GetFullPath([string]$campaign.paths.service_exe)
    Assert-Condition ([IO.Path]::GetDirectoryName($runtimeRoot).Equals($programFiles, [StringComparison]::OrdinalIgnoreCase)) 'Runtime root escaped native Program Files.'
    Assert-Condition ([IO.Path]::GetDirectoryName($activationRoot).Equals($runtimeRoot, [StringComparison]::OrdinalIgnoreCase)) 'Activation-service root escaped the fixed Runtime root.'
    Assert-Condition ([IO.Path]::GetDirectoryName($servicePath).Equals($activationRoot, [StringComparison]::OrdinalIgnoreCase)) 'Activation-service executable escaped its fixed directory.'
    foreach ($path in @($programFiles, $runtimeRoot, $activationRoot, $servicePath)) {
