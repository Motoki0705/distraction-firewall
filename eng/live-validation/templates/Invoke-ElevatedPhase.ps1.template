function Assert-ServiceConfiguration {
    $service = CimCmdlets\Get-CimInstance -ClassName Win32_Service -Filter "Name='$serviceName'" -ErrorAction Stop
    Assert-Condition ($null -ne $service) 'Activation service is missing.'
    $expectedCommand = '"' + [string]$campaign.paths.service_exe + '" --service'
    Assert-Condition ([string]$service.PathName -ceq $expectedCommand) 'Activation service command is not the fixed quoted command.'
    Assert-Condition ([string]$service.StartName -ceq 'LocalSystem') 'Activation service is not LocalSystem.'
    Assert-Condition ([string]$service.StartMode -ceq 'Auto' -and [string]$service.State -ceq 'Running') 'Activation service is not running/automatic.'
    Assert-Condition ([string]$service.ServiceType -ceq 'Own Process' -and [uint32]$service.ProcessId -gt 0) 'Activation service is not a running own-process service.'
    $serviceProcess = CimCmdlets\Get-CimInstance -ClassName Win32_Process -Filter ("ProcessId={0}" -f [uint32]$service.ProcessId) -ErrorAction Stop
    Assert-Condition ($null -ne $serviceProcess -and [IO.Path]::GetFullPath([string]$serviceProcess.ExecutablePath).Equals([IO.Path]::GetFullPath([string]$campaign.paths.service_exe), [StringComparison]::OrdinalIgnoreCase)) 'Activation service process image is not the fixed service executable.'
    Assert-ProtectedRuntimeServicePath
    $serviceExecutable = Get-Item -LiteralPath $campaign.paths.service_exe -Force
    Assert-Condition (($serviceExecutable.Attributes -band [IO.FileAttributes]::ReparsePoint) -eq 0) 'Activation service executable is a reparse point.'
    $serviceKey = "Registry::HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\$serviceName"
    Assert-Condition ([int](Get-ItemPropertyValue -LiteralPath $serviceKey -Name 'DelayedAutostart' -ErrorAction Stop) -eq 1) 'Delayed automatic start is not enabled.'
    $failure = [DistractionFirewall.LiveValidation.NativeInspection]::ReadFailureActions($serviceName)
    Assert-Condition ($failure.ResetPeriodSeconds -eq 86400) 'Failure-action reset period is not one day.'
    Assert-Condition (($failure.ActionTypes -join ',') -ceq '1,1,1') 'Failure actions are not three service restarts.'
    Assert-Condition (($failure.ActionDelaysMilliseconds -join ',') -ceq '5000,5000,5000') 'Failure-action delays are not three 5-second delays.'
    Assert-Condition $failure.ApplyOnNonCrashFailures 'Failure actions do not apply to returned-error failures.'
    $seed = Get-ItemProperty -LiteralPath $campaign.paths.runtime_seed_key -ErrorAction Stop
    Assert-Condition ([string]$seed.OwnerSid -ceq [string]$campaign.owner_sid) 'Runtime owner SID seed differs from the campaign owner.'
    Assert-Condition ([string]$seed.ProductInstanceId -ceq [string]$campaign.fixed.ProductInstanceId) 'Runtime ProductInstanceId seed differs from the fixed value.'
    Assert-Condition ([IO.Path]::GetFullPath([string]$seed.DataRoot).TrimEnd('\').Equals([IO.Path]::GetFullPath([string]$campaign.paths.runtime_data_root).TrimEnd('\'), [StringComparison]::OrdinalIgnoreCase)) 'Runtime DataRoot seed differs from the fixed path.'
    return [pscustomobject][ordered]@{
        name = $serviceName
        state = [string]$service.State
        start_mode = [string]$service.StartMode
        account = [string]$service.StartName
        command = [string]$service.PathName
        process_id = [uint32]$service.ProcessId
        process_executable_path = [string]$serviceProcess.ExecutablePath
        executable_sha256 = Get-LowerSha256 $serviceExecutable.FullName
        delayed_auto_start = $true
        failure_reset_seconds = $failure.ResetPeriodSeconds
        failure_action_types = @($failure.ActionTypes)
        failure_action_delays_ms = @($failure.ActionDelaysMilliseconds)
        failure_actions_on_non_crash = $failure.ApplyOnNonCrashFailures
    }
}

function Copy-ProtectedCleanupDiagnostic {
    param([Parameter(Mandatory)][string]$StageName)
    # The product owns exactly this secret-free diagnostic name. Absence is
    # normal. The path is fixed; no wildcard discovery is permitted here.
    $diagnosticPath = Join-Path $campaign.paths.runtime_data_root 'cleanup-failure.json'
    if (-not (Test-Path -LiteralPath $diagnosticPath -PathType Leaf)) { return $null }
    $item = Get-Item -LiteralPath $diagnosticPath -Force
    Assert-Condition (($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -eq 0) 'Cleanup diagnostic is a reparse point.'
    Assert-Condition ($item.Length -le 1048576) 'Cleanup diagnostic exceeds the fixed 1 MiB limit.'
    $diagnostic = Read-StrictUtf8Json $diagnosticPath
    $expectedProperties = @('schema_version', 'occurred_at_utc', 'operation', 'stage', 'backend', 'backend_operation', 'exceptions') | Sort-Object
    $actualProperties = @($diagnostic.PSObject.Properties.Name | Sort-Object)
    Assert-Condition (-not [bool](Compare-Object -ReferenceObject $expectedProperties -DifferenceObject $actualProperties)) 'Cleanup diagnostic has an unexpected field set.'
    Assert-Condition ([int]$diagnostic.schema_version -eq 1 -and [string]$diagnostic.operation -ceq 'runtime-installation-cleanup') 'Cleanup diagnostic schema/operation mismatch.'
    Assert-Condition ([string]$diagnostic.stage -cin @('resolve-installed-paths', 'verify-execution-identity', 'verify-inactive-lease', 'resolve-product-identity', 'create-cleanup-backends', 'remove-owned-installation-resources')) 'Cleanup diagnostic stage is invalid.'
    Assert-Condition ($null -eq $diagnostic.backend -or [string]$diagnostic.backend -cin @('windows-wfp-infrastructure', 'windows-task-scheduler-infrastructure')) 'Cleanup diagnostic backend is invalid.'
    Assert-Condition ($null -eq $diagnostic.backend_operation -or [string]$diagnostic.backend_operation -cin @('preflight-validation', 'compare-and-delete')) 'Cleanup diagnostic backend operation is invalid.'
    Assert-Condition (@($diagnostic.exceptions).Count -ge 1 -and @($diagnostic.exceptions).Count -le 8) 'Cleanup diagnostic exception chain is invalid.'
    foreach ($exception in @($diagnostic.exceptions)) {
        Assert-Condition ([string]$exception.type -cmatch '^[A-Za-z0-9_.+`]+$' -and [string]$exception.h_result -cmatch '^0x[0-9A-F]{8}$') 'Cleanup diagnostic exception descriptor is invalid.'
    }
    $destination = Join-Path $stageEvidenceRoot "$StageName-installation-cleanup-diagnostic.json"
    Copy-Item -LiteralPath $diagnosticPath -Destination $destination
    return [pscustomobject][ordered]@{
        source_path = $diagnosticPath
        evidence_name = [IO.Path]::GetFileName($destination)
        size = $item.Length
        sha256 = Get-LowerSha256 $destination
    }
}

