trap {
    $currentFatalMessage = ConvertTo-BoundedDiagnosticText $_.Exception.Message
    $bodyFatalMessage = ConvertTo-BoundedDiagnosticText $script:campaignError
    $fatalMessage = if ([string]::IsNullOrWhiteSpace($bodyFatalMessage)) { $currentFatalMessage } else { $bodyFatalMessage }
    $fatalSecondaryError = if (-not [string]::IsNullOrWhiteSpace($bodyFatalMessage) -and $currentFatalMessage -cne $bodyFatalMessage) { $currentFatalMessage } else { $null }
    $fatalTeardownError = $null
    if ($script:stageCreatedByCampaign) {
        try {
            Remove-VerifiedStageTree $stageRoot
            $script:stageCreatedByCampaign = $false
        }
        catch { $fatalTeardownError = ConvertTo-BoundedDiagnosticText $_.Exception.Message }
    }
    try {
        if (Test-Path -LiteralPath $returnedEvidenceRoot -PathType Container) {
            $fatalPath = Join-Path $returnedEvidenceRoot 'fatal-error.json'
            if (-not (Test-Path -LiteralPath $fatalPath)) {
                Write-NewJson $fatalPath ([ordered]@{
                    schema = 'distraction-firewall/live-validation-fatal/v1'
                    campaign_id = [string]$campaign.campaign_id
                    outcome = 'failed'
                    recorded_at_utc = [DateTime]::UtcNow.ToString('o')
                    error = $fatalMessage
                    secondary_error = $fatalSecondaryError
                    protected_stage_teardown_error = $fatalTeardownError
                    lease_started = $false
                })
            }
        }
    }
    catch { }
    [Console]::Error.WriteLine("Fatal live-validation error: $fatalMessage; protected stage teardown: $fatalTeardownError")
    exit 1
}

