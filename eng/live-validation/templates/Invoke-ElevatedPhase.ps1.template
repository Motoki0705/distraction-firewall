        Assert-LeafFingerprint (Join-Path $returnedEvidenceRoot $record.name) $record.size $record.sha256 '' "pinned evidence input $($record.name)"
    }
}

function Write-NewJson {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)]$Value
    )
    $json = $Value | ConvertTo-Json -Depth 30
    $encoding = [Text.UTF8Encoding]::new($false)
    $stream = [IO.File]::Open($Path, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::Read)
    try {
        $writer = [IO.StreamWriter]::new($stream, $encoding)
        try { $writer.WriteLine($json) } finally { $writer.Dispose() }
    }
    finally { $stream.Dispose() }
}

function Write-Phase {
    param(
        [Parameter(Mandatory)][string]$FileName,
        [Parameter(Mandatory)][string]$Phase,
        [Parameter(Mandatory)][string]$Outcome,
        [hashtable]$Additional
    )
    $record = [ordered]@{
        schema = 'distraction-firewall/live-validation-phase/v1'
        campaign_id = [string]$campaign.campaign_id
        phase_nonce = [string]$campaign.phase_nonce
        phase = $Phase
        outcome = $Outcome
        recorded_at_utc = [DateTime]::UtcNow.ToString('o')
        owner_sid = [Security.Principal.WindowsIdentity]::GetCurrent().User.Value
        elevated = $true
    }
    if ($null -ne $Additional) {
        foreach ($key in $Additional.Keys) { $record[$key] = $Additional[$key] }
    }
    Write-NewJson (Join-Path $stateRoot $FileName) $record
}

function Read-SmokePhase {
    $path = Join-Path $stateRoot 'standard-user-smoke-complete.json'
    $deadline = [DateTime]::UtcNow.AddMinutes(12)
    while ([DateTime]::UtcNow -lt $deadline) {
        if (Test-Path -LiteralPath $path -PathType Leaf) {
            $record = Read-StrictUtf8Json $path
            Assert-Condition ([string]$record.schema -ceq 'distraction-firewall/live-validation-phase/v1') 'Standard-user phase schema mismatch.'
            Assert-Condition ([string]$record.campaign_id -ceq [string]$campaign.campaign_id) 'Standard-user phase campaign mismatch.'
            Assert-Condition ([string]$record.phase_nonce -ceq [string]$campaign.phase_nonce) 'Standard-user phase nonce mismatch.'
            Assert-Condition ([string]$record.phase -ceq 'standard-user-smoke-complete') 'Standard-user phase type mismatch.'
            Assert-Condition ([string]$record.outcome -cin @('passed', 'failed')) 'Standard-user phase outcome is invalid.'
            Assert-Condition ([string]$record.owner_sid -ceq [string]$campaign.owner_sid -and -not [bool]$record.elevated) 'Standard-user phase crossed the owner/token boundary.'
            Assert-Condition (-not [bool]$record.lease_start_invoked) 'Standard-user phase reported a lease-start operation.'
            return $record
        }
        Start-Sleep -Milliseconds 250
    }
    throw 'Timed out waiting for standard-user smoke; proceeding to exact uninstall.'
}

function Get-PendingRenameSnapshot {
    $base = [Microsoft.Win32.RegistryKey]::OpenBaseKey([Microsoft.Win32.RegistryHive]::LocalMachine, [Microsoft.Win32.RegistryView]::Registry64)
    try {
        $key = $base.OpenSubKey('SYSTEM\CurrentControlSet\Control\Session Manager', $false)
        Assert-Condition ($null -ne $key) 'Session Manager registry key is missing.'
        try {
            $values = [ordered]@{}
            foreach ($name in @('PendingFileRenameOperations', 'PendingFileRenameOperations2')) {
                $names = @($key.GetValueNames())
                if ($names -cnotcontains $name) {
                    $values[$name] = [ordered]@{ present = $false; kind = $null; pairs = @() }
                    continue
                }
                $kind = $key.GetValueKind($name).ToString()
                Assert-Condition ($kind -ceq 'MultiString') "$name must be REG_MULTI_SZ."
                [string[]]$raw = @($key.GetValue($name, $null, [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames))
                Assert-Condition (($raw.Count % 2) -eq 0) "$name has an incomplete source/destination pair."
                $pairs = @()
                for ($index = 0; $index -lt $raw.Count; $index += 2) {
                    Assert-Condition (-not [string]::IsNullOrEmpty($raw[$index])) "$name contains an empty source."
                    $pairs += [ordered]@{ source = $raw[$index]; destination = $raw[$index + 1] }
                }
                $values[$name] = [ordered]@{ present = $true; kind = $kind; pairs = @($pairs) }
            }
            return [pscustomobject][ordered]@{ schema = 'distraction-firewall/pending-rename-snapshot/v1'; values = [pscustomobject]$values }
        }
        finally { $key.Dispose() }
    }
    finally { $base.Dispose() }
}

function Get-PendingPairs {
    param(
        [Parameter(Mandatory)]$Snapshot,
        [Parameter(Mandatory)][string]$Name
    )
    $value = $Snapshot.values.PSObject.Properties[$Name].Value
    return @($value.pairs)
}

function Assert-PendingRenameEquals {
    param(
        [Parameter(Mandatory)]$Expected,
        [Parameter(Mandatory)]$Actual,
        [Parameter(Mandatory)][string]$Description
    )
    Assert-Condition ([string]$Expected.schema -ceq 'distraction-firewall/pending-rename-snapshot/v1' -and [string]$Actual.schema -ceq [string]$Expected.schema) "$Description schema mismatch."
    foreach ($name in @('PendingFileRenameOperations', 'PendingFileRenameOperations2')) {
        $expectedValue = $Expected.values.PSObject.Properties[$name].Value
        $actualValue = $Actual.values.PSObject.Properties[$name].Value
        Assert-Condition ([bool]$expectedValue.present -eq [bool]$actualValue.present -and [string]$expectedValue.kind -ceq [string]$actualValue.kind) "$Description changed $name presence/type."
        $expectedPairs = @(Get-PendingPairs $Expected $name)
        $actualPairs = @(Get-PendingPairs $Actual $name)
        Assert-Condition ($expectedPairs.Count -eq $actualPairs.Count) "$Description changed $name pair count."
        for ($index = 0; $index -lt $expectedPairs.Count; $index++) {
            Assert-Condition ([string]$expectedPairs[$index].source -ceq [string]$actualPairs[$index].source -and [string]$expectedPairs[$index].destination -ceq [string]$actualPairs[$index].destination) "$Description changed $name pair order/content."
        }
    }
}

function Assert-PendingRenameBaselinePlusBurn {
    param(
        [Parameter(Mandatory)]$Baseline,
        [Parameter(Mandatory)]$Actual
    )
    $verifiedExtras = @()
    foreach ($name in @('PendingFileRenameOperations', 'PendingFileRenameOperations2')) {
        $baselineValue = $Baseline.values.PSObject.Properties[$name].Value
        $actualValue = $Actual.values.PSObject.Properties[$name].Value
        $baselinePairs = @(Get-PendingPairs $Baseline $name)
        $actualPairs = @(Get-PendingPairs $Actual $name)
        Assert-Condition ($actualPairs.Count -ge $baselinePairs.Count) "Postflight removed a baseline $name pair."
        for ($index = 0; $index -lt $baselinePairs.Count; $index++) {
            Assert-Condition ([string]$baselinePairs[$index].source -ceq [string]$actualPairs[$index].source -and [string]$baselinePairs[$index].destination -ceq [string]$actualPairs[$index].destination) "Postflight changed baseline $name order/content."
        }
        foreach ($pair in @($actualPairs | Select-Object -Skip $baselinePairs.Count)) {
            Assert-Condition ($name -ceq 'PendingFileRenameOperations') 'Burn pending delete appeared in the unsupported secondary value.'
            Assert-Condition ([string]::IsNullOrEmpty([string]$pair.destination)) 'New pending rename is not a delete operation.'
            $prefix = '*1\??\'
            Assert-Condition (([string]$pair.source).StartsWith($prefix, [StringComparison]::Ordinal)) 'New pending delete has an unsupported source prefix.'
            $path = [IO.Path]::GetFullPath(([string]$pair.source).Substring($prefix.Length))
            $tempRoot = [IO.Path]::GetFullPath([string]$campaign.paths.owner_temp_root).TrimEnd('\')
            Assert-Condition ([IO.Path]::GetDirectoryName($path).Equals($tempRoot, [StringComparison]::OrdinalIgnoreCase)) 'Burn pending delete is outside the fixed owner Temp root.'
            Assert-Condition ([IO.Path]::GetFileName($path) -cmatch '^DEL[0-9A-F]{4}\.tmp$') 'Burn pending-delete filename is not canonical.'
            Assert-LeafFingerprint $path ([int64]$campaign.candidate.setup.burn_engine_size) $campaign.candidate.setup.burn_engine_sha256 '' 'detached Burn engine'
            $verifiedExtras += [ordered]@{ value_name = $name; source = [string]$pair.source; destination = ''; path = $path; sha256 = Get-LowerSha256 $path }
        }
        if ($actualPairs.Count -eq 0) {
            Assert-Condition (-not [bool]$actualValue.present -or [string]$actualValue.kind -ceq 'MultiString') 'Postflight pending rename type is invalid.'
        }
    }
    return @($verifiedExtras)
}

function Convert-RegistryValueForEvidence {
    param(
        [Parameter(Mandatory)]$Value,
        [Parameter(Mandatory)][string]$Kind
    )
    switch ($Kind) {
        'Binary' { return [Convert]::ToBase64String([byte[]]$Value) }
        'MultiString' { return @([string[]]$Value) }
        'DWord' { return ([uint32]$Value).ToString([Globalization.CultureInfo]::InvariantCulture) }
        'QWord' { return ([uint64]$Value).ToString([Globalization.CultureInfo]::InvariantCulture) }
        default { return [string]$Value }
    }
}

