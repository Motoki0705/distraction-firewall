function Test-IsMissingTaskFolderException {
    param([Parameter(Mandatory)][Exception]$Exception)
    return [int]$Exception.HResult -in @(-2147024894, -2147023728)
}

function Get-TaskFolderState {
    $scheduler = New-Object -ComObject 'Schedule.Service'
    try {
        $scheduler.Connect()
        try { $folder = $scheduler.GetFolder('\DistractionFirewall') }
        catch {
            if (Test-IsMissingTaskFolderException $_.Exception) {
                return [pscustomobject][ordered]@{ exists = $false; task_count = 0; folder_count = 0 }
            }
            throw
        }
        try {
            return [pscustomobject][ordered]@{
                exists = $true
                task_count = @($folder.GetTasks(1)).Count
                folder_count = @($folder.GetFolders(0)).Count
            }
        }
        finally { [void][Runtime.InteropServices.Marshal]::FinalReleaseComObject($folder) }
    }
    finally { [void][Runtime.InteropServices.Marshal]::FinalReleaseComObject($scheduler) }
}

