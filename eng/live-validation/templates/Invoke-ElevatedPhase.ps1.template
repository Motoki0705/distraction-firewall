function ConvertTo-BoundedDiagnosticText {
    param(
        [AllowNull()][object]$Value,
        [ValidateRange(64, 4096)][int]$MaximumLength = 2048
    )

    if ($null -eq $Value) { return $null }
    $text = [string]$Value
    if ($text.Length -le $MaximumLength) { return $text }
    $suffix = '... [truncated]'
    return $text.Substring(0, $MaximumLength - $suffix.Length) + $suffix
}

