    $identity = Get-MsiIdentity $Path
    Assert-Condition ($identity.product_code -ceq [string]$Record.product_code) "$Description ProductCode mismatch."
    Assert-Condition ($identity.package_code -ceq [string]$Record.package_code) "$Description PackageCode mismatch."
    Assert-Condition ($identity.upgrade_code -ceq [string]$Record.upgrade_code) "$Description UpgradeCode mismatch."
    Assert-Condition ($identity.product_version -ceq [string]$Record.product_version) "$Description ProductVersion mismatch."
}

