Assert-Condition (@(Get-ChildItem -LiteralPath $stateRoot -Force).Count -eq 0) 'Campaign state is not empty; campaigns cannot be resumed or replayed.'
Assert-Condition (@(Get-ChildItem -LiteralPath $evidenceRoot -Force).Count -eq 0) 'Campaign evidence is not empty; use a newly generated campaign.'
Copy-PinnedEvidenceInput $campaign.input_records.candidate_manifest_path 'candidate-manifest.json' ([int64]$campaign.input_records.candidate_manifest_size) $campaign.input_records.candidate_manifest_sha256
Copy-PinnedEvidenceInput $campaign.input_records.provenance_envelope_path 'provenance-envelope.json' ([int64]$campaign.input_records.provenance_envelope_size) $campaign.input_records.provenance_envelope_sha256
Copy-PinnedEvidenceInput $campaign.candidate.hosted_evidence.path 'hosted-evidence.json' ([int64]$campaign.candidate.hosted_evidence.size) $campaign.candidate.hosted_evidence.sha256
Copy-PinnedEvidenceInput $campaign.candidate.subjects.path 'candidate-subjects.sha256' ([int64]$campaign.candidate.subjects.size) $campaign.candidate.subjects.sha256
Copy-PinnedEvidenceInput $campaign.candidate.attestation_bundle.path 'provenance.bundle.json' ([int64]$campaign.candidate.attestation_bundle.size) $campaign.candidate.attestation_bundle.sha256
if ($null -ne $campaign.recovery) {
    Copy-PinnedEvidenceInput $campaign.recovery.manifest_path 'runtime-recovery-manifest.json' ([int64]$campaign.recovery.manifest_size) $campaign.recovery.manifest_sha256
}
Write-NewJson (Join-Path $evidenceRoot 'execution-environment.json') $executionEnvironmentSnapshot
$parentStarted = [ordered]@{
    schema = 'distraction-firewall/live-validation-phase/v1'
    campaign_id = [string]$campaign.campaign_id
    phase_nonce = [string]$campaign.phase_nonce
    phase = 'parent-started'
    recorded_at_utc = [DateTime]::UtcNow.ToString('o')
    owner_sid = $identity.User.Value
    elevated = $false
}
Write-NewJson (Join-Path $stateRoot 'parent-started.json') $parentStarted
Write-NewJson (Join-Path $stateRoot 'pending-rename-baseline.json') $pendingRenameBaseline
Write-NewJson (Join-Path $stateRoot 'system-baseline.json') $systemBaseline

$elevatedProcess = $null
$smokeMarkerWritten = $false
try {
    # This is the campaign's only elevation boundary. The short bootstrap pins
    # the absolute child path and digest. After consent it opens the source with
    # FileShare.None, hashes those exact bytes, and executes those same bytes in
    # memory. UAC wait time therefore cannot become a hash-to-load race.
    $bootstrapTemplate = @'
$ErrorActionPreference = 'Stop'
$windowsDirectory = [IO.Path]::GetFullPath([Environment]::GetFolderPath([Environment+SpecialFolder]::Windows)).TrimEnd('\')
$systemDirectory = [IO.Path]::GetFullPath([Environment]::GetFolderPath([Environment+SpecialFolder]::System)).TrimEnd('\')
$trustedPowerShellRoot = [IO.Path]::GetFullPath([IO.Path]::Combine($systemDirectory, 'WindowsPowerShell')).TrimEnd('\')
$trustedPowerShellHome = [IO.Path]::GetFullPath([IO.Path]::Combine($trustedPowerShellRoot, 'v1.0')).TrimEnd('\')
if (-not ([IO.Path]::GetFullPath($PSHOME).TrimEnd('\').Equals($trustedPowerShellHome, [StringComparison]::OrdinalIgnoreCase))) {
    throw 'Elevated bootstrap is not running from native Windows PowerShell 5.1.'
}
$trustedPowerShellModuleRoot = [IO.Path]::Combine($trustedPowerShellHome, 'Modules')
$env:PATH = "$systemDirectory;$windowsDirectory;$trustedPowerShellHome"
$env:PSModulePath = $trustedPowerShellModuleRoot
$env:PATHEXT = '.COM;.EXE;.BAT;.CMD'
$env:PSExecutionPolicyPreference = 'Bypass'
$env:SystemRoot = $windowsDirectory
$env:windir = $windowsDirectory
$env:ComSpec = [IO.Path]::Combine($systemDirectory, 'cmd.exe')
foreach ($moduleName in @('Microsoft.PowerShell.Management', 'Microsoft.PowerShell.Utility', 'Microsoft.PowerShell.Security')) {
    $moduleManifest = [IO.Path]::Combine($trustedPowerShellModuleRoot, $moduleName, "$moduleName.psd1")
    Microsoft.PowerShell.Core\Import-Module -Name $moduleManifest -Force -ErrorAction Stop
}
$PSModuleAutoLoadingPreference = 'None'
$runnerPath = '__RUNNER_PATH__'
$expectedSha256 = '__RUNNER_SHA256__'
$stream = [IO.File]::Open($runnerPath, [IO.FileMode]::Open, [IO.FileAccess]::Read, [IO.FileShare]::None)
try {
    $memory = [IO.MemoryStream]::new()
    try {
        $stream.CopyTo($memory)
        [byte[]]$bytes = $memory.ToArray()
    }
    finally { $memory.Dispose() }
    $algorithm = [Security.Cryptography.SHA256]::Create()
    try { $actual = ([BitConverter]::ToString($algorithm.ComputeHash($bytes))).Replace('-', '').ToLowerInvariant() }
    finally { $algorithm.Dispose() }
    if ($actual -cne $expectedSha256) { throw 'Elevated runner hash mismatch after UAC consent.' }
    $utf8 = [Text.UTF8Encoding]::new($false, $true)
    $text = $utf8.GetString($bytes)
    if ($text.IndexOf([char]0) -ge 0) { throw 'Elevated runner contains a NUL character.' }
    $scriptBlock = [ScriptBlock]::Create($text)
    & $scriptBlock
    if ($null -ne $LASTEXITCODE) { exit $LASTEXITCODE }
    exit 0
}
finally { $stream.Dispose() }
'@
    $bootstrap = $bootstrapTemplate.
        Replace('__RUNNER_PATH__', $elevatedRunner.Replace("'", "''")).
        Replace('__RUNNER_SHA256__', $expectedElevatedRunnerSha256)
    $encodedBootstrap = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($bootstrap))
    Assert-Condition ($encodedBootstrap.Length -lt 24000) 'Pinned elevated bootstrap exceeds the reviewed command-line limit.'
    $elevatedProcess = Start-TrustedElevatedPowerShell -EncodedBootstrap $encodedBootstrap -ExecutablePath $windowsPowerShell

    $readyPath = Join-Path $stateRoot 'awaiting-standard-user-smoke.json'
    $ready = Wait-ForPhase -Path $readyPath -ExpectedPhase 'awaiting-standard-user-smoke' -ElevatedProcess $elevatedProcess -TimeoutSeconds 1200
    Assert-Condition ([string]$ready.outcome -ceq 'ready') 'Elevated installation phase did not become ready.'
    Assert-Condition (-not (Test-Path -LiteralPath $campaign.paths.active_marker)) 'An active lease exists after install; refusing client smoke.'

    $targets = Invoke-FixedCli -Command targets -OutputBaseName 'cli-targets'
    $status = Invoke-FixedCli -Command status -OutputBaseName 'cli-status'
    $diagnostics = Invoke-FixedCli -Command diagnose -OutputBaseName 'cli-diagnose'
    Assert-Condition (@($targets.targets).Count -eq 1) 'Target catalog must contain exactly the YouTube MVP target.'
    Assert-Condition ([string]$targets.targets[0].stable_id -ceq 'youtube') 'Target catalog does not contain the fixed YouTube target.'
    Assert-Condition ([string]$status.state -ceq 'idle' -and $null -eq $status.lease_id) 'Status is not idle/no-lease.'
    Assert-Condition (@($diagnostics.checks).Count -gt 0 -and @($diagnostics.checks | Where-Object { -not $_.is_healthy }).Count -eq 0) 'Runtime diagnostics are not healthy.'
    $ui = Invoke-UiSmoke
    Assert-Condition (-not (Test-Path -LiteralPath $campaign.paths.active_marker)) 'Client smoke created an active lease.'

    $smoke = [ordered]@{
        schema = 'distraction-firewall/live-validation-phase/v1'
        campaign_id = [string]$campaign.campaign_id
        phase_nonce = [string]$campaign.phase_nonce
        phase = 'standard-user-smoke-complete'
        outcome = 'passed'
        recorded_at_utc = [DateTime]::UtcNow.ToString('o')
        owner_sid = $identity.User.Value
        elevated = $false
        commands = @('targets --json', 'status --json', 'diagnose --json')
        ui = $ui
        lease_start_invoked = $false
    }
    Write-NewJson (Join-Path $stateRoot 'standard-user-smoke-complete.json') $smoke
    Write-NewJson (Join-Path $evidenceRoot 'standard-user-smoke.json') $smoke
    $smokeMarkerWritten = $true
}
catch {
    $failure = [ordered]@{
        schema = 'distraction-firewall/live-validation-phase/v1'
        campaign_id = [string]$campaign.campaign_id
        phase_nonce = [string]$campaign.phase_nonce
        phase = 'standard-user-smoke-complete'
        outcome = 'failed'
        recorded_at_utc = [DateTime]::UtcNow.ToString('o')
        owner_sid = $identity.User.Value
        elevated = $false
        error = $_.Exception.Message
        lease_start_invoked = $false
    }
    if ($null -ne $elevatedProcess -and -not $smokeMarkerWritten -and -not (Test-Path -LiteralPath (Join-Path $stateRoot 'standard-user-smoke-complete.json'))) {
        Write-NewJson (Join-Path $stateRoot 'standard-user-smoke-complete.json') $failure
        $smokeMarkerWritten = $true
    }
    if (-not (Test-Path -LiteralPath (Join-Path $evidenceRoot 'standard-user-smoke.json'))) {
        Write-NewJson (Join-Path $evidenceRoot 'standard-user-smoke.json') $failure
    }
    throw
}
finally {
    if ($null -ne $elevatedProcess -and -not $elevatedProcess.HasExited) {
        $null = $elevatedProcess.WaitForExit(1200000)
    }
}

Assert-Condition ($elevatedProcess.HasExited) 'Elevated campaign did not finish cleanup within the fixed timeout.'
